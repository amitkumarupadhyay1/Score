{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Score WPF App",
			"type": "shell",
			"command": "powershell",
			"args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build.ps1", "-Configuration", "Debug", "-RunChecks"],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Run Score WPF App",
			"type": "shell",
			"command": "Start-Process '${workspaceFolder}\\Score\\bin\\Debug\\Score.exe'",
			"dependsOn": "Build Score WPF App",
			"problemMatcher": []
		}
	]
}
