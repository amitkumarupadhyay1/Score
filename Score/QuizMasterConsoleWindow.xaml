<Window x:Class="Score.QuizMasterConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Master Live Conducting Desk"
        MinWidth="1050" MinHeight="680"
        Width="1280" Height="820"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6F8"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header: Session & System Controls -->
        <Border Grid.Row="0" Background="#FF0F172A" Padding="14,8" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Brand & Deck Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,3">
                    <Border Background="#FF4F46E5" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                        <TextBlock Text="✦" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="QUIZ DESK" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                    
                    <!-- Session Status Pill -->
                    <Border x:Name="ConsoleSessionBadge" Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ConsoleSessionDot" Text="○" Foreground="#FF94A3B8" FontSize="11" Margin="0,0,4,0" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConsoleSessionBadgeText" Text="STANDBY" FontSize="10" FontWeight="Bold" Foreground="#FF94A3B8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Deck Selector -->
                    <Border Background="#FF1E293B" CornerRadius="7" Padding="10,4" BorderBrush="#FF334155" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Deck:" FontSize="12" FontWeight="SemiBold" Foreground="#FF94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="ConsoleDeckSelector" MinWidth="220" MaxWidth="380" Height="28" DisplayMemberPath="Title"
                                      SelectedValuePath="QuizDeckId" SelectionChanged="ConsoleDeckSelector_SelectionChanged"
                                      Background="#FF0F172A" Foreground="#FFFFFFFF" BorderThickness="0" VerticalContentAlignment="Center"
                                      FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Controls Group -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                    <!-- Stage & Audio -->
                    <Button x:Name="SoundToggleButton" Content="🔊 SOUND ON" Style="{StaticResource ToolbarButtonStyle}" Background="#FF059669" BorderBrush="#FF047857" Foreground="#FFFFFFFF" Margin="0,0,6,0" Click="SoundToggleButton_Click" ToolTip="Toggle sound effects on / off" />
                    <Button x:Name="MobileBuzzerButton" Content="📱 MOBILE BUZZERS (QR)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF4F46E5" BorderBrush="#FF4338CA" Foreground="#FFFFFFFF" Margin="0,0,6,0" Click="MobileBuzzerButton_Click" ToolTip="Host local Wi-Fi mobile buzzers with QR code for contestants" />
                    <Button x:Name="OpenProjectorButton" Content="AUDIENCE VIEW (STAGE)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF0288D1" BorderBrush="#FF0277BD" Foreground="#FFFFFFFF" Margin="0,0,8,0" Click="OpenProjectorButton_Click" ToolTip="Open the audience/projector window for the stage screen" />

                    <Border Width="1" Height="20" Background="#FF334155" Margin="2,0,8,0" VerticalAlignment="Center" />

                    <!-- Live Conducting Controls -->
                    <Button x:Name="StartQuizButton" Content="▶ START QUIZ" Style="{StaticResource ToolbarButtonStyle}" Background="#FF059669" BorderBrush="#FF10B981" Foreground="#FFFFFFFF" FontWeight="Bold" Margin="0,0,6,0" Click="StartQuizButton_Click" ToolTip="Begin live conducting with registered teams" />
                    <Button x:Name="EndQuizButton" Content="⏹ FINISH QUIZ" Style="{StaticResource ToolbarButtonStyle}" Background="#FFDC2626" BorderBrush="#FFB91C1C" Foreground="#FFFFFFFF" FontWeight="SemiBold" Margin="0,0,8,0" Click="EndQuizButton_Click" ToolTip="Complete current quiz session and lock final scores" Visibility="Collapsed" />

                    <Border Width="1" Height="20" Background="#FF334155" Margin="2,0,8,0" VerticalAlignment="Center" />

                    <!-- Desk Tools -->
                    <Button x:Name="SyncToDeskButton" Content="SYNC TO MAIN DESK" Style="{StaticResource ToolbarButtonStyle}" Background="#FF7C3AED" BorderBrush="#FF6D28D9" Foreground="#FFFFFFFF" Margin="0,0,6,0" Click="SyncToDeskButton_Click" ToolTip="Mirror current session totals to the main Live Score Desk" />
                    <Button x:Name="ExportResultsButton" Content="EXPORT RESULTS" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Click="ExportResultsButton_Click" ToolTip="Export questions and scoring details to CSV" />
                    <Button x:Name="AuditLogButton" Content="AUDIT LOG" Style="{StaticResource ToolbarButtonStyle}" Click="AuditLogButton_Click" ToolTip="View full chronological audit trail of all answers and score adjustments" />
                </WrapPanel>

            </WrapPanel>
        </Border>

        <!-- Main Body: 3-Column Desk -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Slide & Question Navigator -->
            <Border Grid.Column="0" BorderBrush="#FFD6DEE8" BorderThickness="0,0,1,0" Background="#FFFFFFFF">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFF1F5F9" Padding="12,8">
                        <TextBlock Text="QUESTION OUTLINE" FontSize="11" FontWeight="Bold" Foreground="#FF334155" />
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#FFF1F5F9" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevSlideButton" Grid.Column="0" Content="◀ PREV (P)" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0" Click="PrevSlideButton_Click" />
                            <Button x:Name="NextSlideButton" Grid.Column="1" Content="NEXT (N) ▶" Style="{StaticResource ToolbarButtonStyle}" Margin="4,0,0,0" Background="#FFDCEBFA" BorderBrush="#FFA8C5E3" Click="NextSlideButton_Click" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ConsoleSlideList" BorderThickness="0" Background="#FFFFFFFF" SelectionChanged="ConsoleSlideList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFF8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFEFF6FF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Index}" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding SlideType}" FontSize="9" FontWeight="Bold" Foreground="#FF15803D" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1E293B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Column 2: Quizmaster Prompter & Live Controls -->
            <Border Grid.Column="1" BorderBrush="#FFD6DEE8" BorderThickness="0,0,1,0" Background="#FFFFFFFF">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,18">
                        
                        <!-- Top Metadata & State Bar -->
                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <WrapPanel Margin="0,0,0,6">
                                        <Border x:Name="ConsoleRoundBadge" Background="#FFE0F2FE" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="ConsoleRoundText" Text="General" FontSize="10" FontWeight="Bold" Foreground="#FF0369A1" />
                                        </Border>
                                        <Border Background="#FFDCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="ConsoleSlideType" Text="Question" FontSize="10" FontWeight="Bold" Foreground="#FF15803D" />
                                        </Border>
                                        <Border Background="#FFFEF3C7" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="ConsolePointsBadge" Text="10 Points" FontSize="10" FontWeight="Bold" Foreground="#FFB45309" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock x:Name="ConsoleSlideTitle" FontSize="20" FontWeight="Bold" Foreground="#FF1E293B" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Big Digital Countdown Timer -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FF0F172A" CornerRadius="8" Padding="14,6" Margin="12,0,8,0">
                                        <TextBlock x:Name="ConsoleTimerLabel" Text="00:00" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="#FF38BDF8" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button x:Name="TimerStartButton" Content="▶" Width="36" Height="28" Margin="0,0,0,4" Style="{StaticResource ToolbarButtonStyle}" Click="TimerStartButton_Click" ToolTip="Start / Resume Timer (Space)" />
                                        <Button x:Name="TimerPauseButton" Content="⏸" Width="36" Height="28" Style="{StaticResource ToolbarButtonStyle}" Click="TimerPauseButton_Click" ToolTip="Pause Timer (Space)" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Floor / Turn & Pass Indicator Banner -->
                        <Border x:Name="TurnBanner" Background="#FFFEF9C3" BorderBrush="#FFFDE047" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TurnStatusLabel" Text="ACTIVE FLOOR: TEAM 1" FontSize="13" FontWeight="Bold" Foreground="#FF854D0E" />
                                    <TextBlock x:Name="TurnDetailsLabel" Text="Direct question · Worth 10 pts · Can pass if missed" FontSize="11" Foreground="#FFA16207" />
                                </StackPanel>
                                <Button x:Name="PassButton" Grid.Column="1" Content="PASS (S)" Style="{StaticResource ToolbarButtonStyle}" Background="#FFF59E0B" BorderBrush="#FFD97706" Foreground="#FFFFFFFF" Padding="14,4" Click="PassButton_Click" ToolTip="Pass / bounce question to next team in turn (Shortcut: S)" />
                            </Grid>
                        </Border>

                        <!-- Media Preview (Host View) -->
                        <Border x:Name="ConsoleMediaPanel" Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12" MaxHeight="220" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Image x:Name="ConsoleMediaImage" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Question Content & Options -->
                        <TextBlock x:Name="ConsoleSlideContent" FontSize="16" Foreground="#FF334155" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConsoleSlideOptions" FontSize="14" Foreground="#FF1E293B" Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="24" />

                        <!-- Secret Host Prompter & Trivia (Host Only) -->
                        <Border Background="#FFF1F5F9" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔒 SECRET HOST PROMPTER &amp; ANSWER KEY" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,6" />
                                <TextBlock x:Name="ConsoleAnswerKey" FontSize="15" FontWeight="Bold" Foreground="#FF15803D" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="ConsoleAlternateAnswers" FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock x:Name="ConsoleExplanation" FontSize="12" FontStyle="Italic" Foreground="#FF334155" TextWrapping="Wrap" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button x:Name="RevealClueButton" Content="💡 REVEAL NEXT CLUE" Style="{StaticResource ToolbarButtonStyle}" Background="#FFFEF08A" BorderBrush="#FFFACC15" Foreground="#FF854D0E" Padding="10,2" DockPanel.Dock="Left" Click="RevealClueButton_Click" Visibility="Collapsed" />
                                    <TextBlock x:Name="ClueStatusLabel" FontSize="11" FontWeight="SemiBold" Foreground="#FF854D0E" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Answer Input & Scoring Controls -->
                        <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TEAM RESPONSE &amp; ADJUDICATION" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,6" />

                                <!-- Quick Choice Buttons (A, B, C, D / True, False) -->
                                <StackPanel x:Name="QuickOptionBar" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="Quick Choice:" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="QuickOptionA" Content="A" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionB" Content="B" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionC" Content="C" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionD" Content="D" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionTrue" Content="TRUE" Height="30" Padding="10,0" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="QuickOptionFalse" Content="FALSE" Height="30" Padding="10,0" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="SubmitAnswerButton" Content="EVALUATE" Style="{StaticResource ToolbarButtonStyle}" Width="90" DockPanel.Dock="Right" Click="SubmitAnswerButton_Click" Margin="8,0,0,0" />
                                    <TextBox x:Name="ConsoleAnswerEditor" Height="32" FontSize="13" Padding="8,4" VerticalContentAlignment="Center" ToolTip="Enter or verify team's submitted response" />
                                </DockPanel>

                                <!-- 1-Click Scoring Bar -->
                                <WrapPanel>
                                    <Button x:Name="MarkCorrectButton" Content="MARK CORRECT (C) ✓" Style="{StaticResource ToolbarButtonStyle}" Background="#FF22C55E" BorderBrush="#FF16A34A" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="MarkCorrectButton_Click" />
                                    <Button x:Name="MarkIncorrectButton" Content="MARK WRONG (X) ✗" Style="{StaticResource ToolbarButtonStyle}" Background="#FFEF4444" BorderBrush="#FFDC2626" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="MarkIncorrectButton_Click" />
                                    <Button x:Name="RevealAnswerButton" Content="REVEAL ON STAGE (R)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF3B82F6" BorderBrush="#FF2563EB" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="RevealAnswerButton_Click" />
                                    <Button x:Name="AcceptBuzzButton" Content="MANUAL BUZZ" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,6" Click="AcceptBuzzButton_Click" ToolTip="Register a buzz for the team currently selected in the team list" />
                                    <Button x:Name="OverrideScoreButton" Content="ADJUDICATE / OVERRIDE" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,6" Click="OverrideScoreButton_Click" />
                                </WrapPanel>

                                <!-- Override Sub-panel -->
                                <StackPanel x:Name="OverrideReasonPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Adjudication Reason:" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,4" />
                                            <TextBox x:Name="OverrideReasonEditor" Height="28" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="New Points / Total:" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,4" />
                                                    <TextBox x:Name="OverrideTotalEditor" Height="28" Width="100" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="APPLY ADJUDICATION" Style="{StaticResource ToolbarButtonStyle}" Background="#FF059669" BorderBrush="#FF047857" Foreground="#FFFFFFFF" Margin="0,0,8,0" Click="ApplyOverrideButton_Click" />
                                                <Button Content="CANCEL" Style="{StaticResource ToolbarButtonStyle}" Click="CancelOverrideButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 3: Live Scoreboard & Buzzer Queue -->
            <Border Grid.Column="2" Background="#FFF1F5F9">
                <DockPanel>
                    
                    <!-- Buzz Queue Banner -->
                    <Border DockPanel.Dock="Top" Background="#FFE2E8F0" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="BUZZER QUEUE &amp; TEAMS" FontSize="11" FontWeight="Bold" Foreground="#FF334155" />
                            <TextBlock Text="Press keys 1-9 on keyboard to register team buzz" FontSize="9" Foreground="#FF64748B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Active Buzz Queue Box -->
                    <Border DockPanel.Dock="Top" x:Name="BuzzQueueContainer" Background="#FFFEF2F2" BorderBrush="#FFFECACA" BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="🚨 ACTIVE BUZZ QUEUE" FontSize="10" FontWeight="Bold" Foreground="#FFB91C1C" />
                            <TextBlock x:Name="BuzzQueueListLabel" Text="1. Team Alpha (Answering)" FontSize="12" FontWeight="SemiBold" Foreground="#FF991B1B" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Team Score List -->
                    <ListBox x:Name="ConsoleTeamList" BorderThickness="0" Background="#FFFFFFFF">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TeamItemBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TeamItemBorder" Property="Background" Value="#FFF8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TeamItemBorder" Property="Background" Value="#FFF0FDF4"/>
                                                    <Setter TargetName="TeamItemBorder" Property="BorderBrush" Value="#FF16A34A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding QuickKey}" FontWeight="Bold" Foreground="#FF94A3B8" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Team}" FontSize="14" FontWeight="SemiBold" Foreground="#FF1E293B" />
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFE11D48" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}" FontSize="22" FontWeight="Bold" Foreground="#FF0F766E" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFF1F5F9" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0" Padding="12,7">
            <TextBlock x:Name="ConsoleStatusText" Text="Ready" FontSize="11" Foreground="#FF475569" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
