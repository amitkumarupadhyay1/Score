<Window x:Class="Score.QuizMasterConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Master Live Conducting Desk"
        MinWidth="1050" MinHeight="680"
        Width="1280" Height="820"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF4F6F8" Offset="0"/><GradientStop Color="#FFEFF2F5" Offset="0.48"/><GradientStop Color="#FFF4F6F8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header: Floating Luminous Broadcast Bar -->
        <Border Grid.Row="0" Margin="12,10,12,6" Padding="14,8" CornerRadius="16" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1" Effect="{StaticResource HeaderGlowEffect}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Brand & Deck Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,14,3">
                    <Border Background="#FF005A9C" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="Q" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="QUIZ CONDUCT" FontSize="14" FontWeight="Bold" Foreground="#FF0F172A" />
                        <TextBlock Text="Live Host Desk" FontSize="10" FontWeight="Bold" Foreground="#FF64748B" />
                    </StackPanel>
                    
                    <!-- Session Status Pill -->
                    <Border x:Name="ConsoleSessionBadge" Background="#FFF1F4F7" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ConsoleSessionDot" Text="○" Foreground="#FF64748B" FontSize="11" Margin="0,0,5,0" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConsoleSessionBadgeText" Text="STANDBY" FontSize="10" FontWeight="Bold" Foreground="#FF334155" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Deck Selector -->
                    <Border Background="#FFF1F4F7" CornerRadius="8" Padding="8,2" BorderBrush="#FFCBD5E1" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Deck:" FontSize="11" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="ConsoleDeckSelector" MinWidth="220" MaxWidth="380" Height="28" DisplayMemberPath="Title"
                                      SelectedValuePath="QuizDeckId" SelectionChanged="ConsoleDeckSelector_SelectionChanged"
                                      Style="{StaticResource ToolbarComboStyle}" BorderThickness="0"
                                      ToolTip="Select active quiz deck" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Controls Group -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                    <!-- Stage & Audio -->
                    <Button x:Name="SoundToggleButton" Content="SOUND ON" Style="{StaticResource BroadcastSuccessButtonStyle}" Margin="0,0,6,0" Click="SoundToggleButton_Click" ToolTip="Toggle sound effects on / off" />
                    <Button x:Name="ArmBuzzerButton" Content="BUZZERS ARMED (A)" Style="{StaticResource BroadcastPrimaryButtonStyle}" Margin="0,0,6,0" Click="ArmBuzzerButton_Click" ToolTip="Arm or lock mobile buzzers (A)" />
                    <Button x:Name="PounceToggleButton" Content="POUNCE: OFF (P)" Style="{StaticResource BroadcastWarningButtonStyle}" Margin="0,0,6,0" Click="PounceToggleButton_Click" ToolTip="Toggle Chit Pounce mode on contestants' mobile screens (Shortcut: P)" />
                    <Button x:Name="BlackoutToggleButton" Content="BLACKOUT (B)" Style="{StaticResource BroadcastDangerButtonStyle}" Margin="0,0,6,0" Click="BlackoutToggleButton_Click" ToolTip="Emergency stage blackout (B)" />
                    <Button x:Name="MobileBuzzerButton" Content="MOBILE BUZZERS (QR)" Style="{StaticResource BroadcastBlueTintButtonStyle}" Margin="0,0,6,0" Click="MobileBuzzerButton_Click" ToolTip="Host local Wi-Fi mobile buzzers with QR code for contestants" />
                    <Button x:Name="OpenProjectorButton" Content="AUDIENCE VIEW (STAGE)" Style="{StaticResource BroadcastBlueTintButtonStyle}" Margin="0,0,8,0" Click="OpenProjectorButton_Click" ToolTip="Open the audience/projector window for the stage screen" />

                    <Border Width="1" Height="20" Background="#FFCBD5E1" Margin="2,0,8,0" VerticalAlignment="Center" />

                    <!-- Live Conducting Controls -->
                    <Button x:Name="StartQuizButton" Content="START QUIZ" Style="{StaticResource BroadcastSuccessButtonStyle}" Margin="0,0,6,0" Click="StartQuizButton_Click" ToolTip="Begin live conducting with registered teams" />
                    <Button x:Name="RapidFireBarrageButton" Content="RAPID FIRE (60s)" Style="{StaticResource BroadcastDangerButtonStyle}" Margin="0,0,6,0" Click="RapidFireBarrageButton_Click" ToolTip="Toggle 60s Rapid-Fire Barrage Mode for selected team" />
                    <Button x:Name="EndQuizButton" Content="FINISH QUIZ" Style="{StaticResource BroadcastDangerButtonStyle}" Margin="0,0,8,0" Click="EndQuizButton_Click" ToolTip="Complete current quiz session and lock final scores" Visibility="Collapsed" />

                    <Border Width="1" Height="20" Background="#FFCBD5E1" Margin="2,0,8,0" VerticalAlignment="Center" />

                    <!-- Desk Tools -->
                    <Button x:Name="SyncToDeskButton" Content="SYNC TO MAIN DESK" Style="{StaticResource BroadcastBlueTintButtonStyle}" Margin="0,0,6,0" Click="SyncToDeskButton_Click" ToolTip="Mirror current session totals to the main Live Score Desk" />
                    <Button x:Name="ExportResultsButton" Content="EXPORT RESULTS" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="ExportResultsButton_Click" ToolTip="Export questions and scoring details to CSV" />
                    <Button x:Name="AuditLogButton" Content="AUDIT LOG" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="AuditLogButton_Click" ToolTip="View full chronological audit trail of all answers and score adjustments" />
                    <Button x:Name="FocusModeButton" Content="FOCUS" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="FocusModeButton_Click" ToolTip="Toggle Focus Mode: collapse side panels (Ctrl+F)" />

                    <!-- Theme Switcher -->
                    <Border Background="#FFF1F4F7" CornerRadius="8" Padding="6,2" BorderBrush="#FFCBD5E1" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Theme:" FontSize="11" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="DeskThemeSelector" Width="130" Height="26" SelectionChanged="DeskThemeSelector_SelectionChanged"
                                      Style="{StaticResource ToolbarComboStyle}" BorderThickness="0"
                                      ToolTip="Change visual theme for stage audience and desk" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

            </WrapPanel>
        </Border>

        <!-- Main Body: 3-Column Desk -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftOutlineColumn" Width="280" MinWidth="0" />
                <ColumnDefinition x:Name="CenterQuestionColumn" Width="*" MinWidth="460" />
                <ColumnDefinition x:Name="RightTeamsColumn" Width="340" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Slide & Question Navigator -->
            <Border Grid.Column="0" BorderBrush="#FFD6DEE8" BorderThickness="0,0,1,0" Background="#FFFFFFFF">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFF8FAFC" BorderBrush="#FFD6DEE8" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel>
                            <Button x:Name="CollapseLeftButton" Content="&lt;" DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Style="{StaticResource BroadcastNeutralButtonStyle}" Click="CollapseLeftButton_Click" ToolTip="Collapse Outline Panel (Ctrl+[)" />
                            <TextBlock Text="QUESTION OUTLINE" FontSize="11" FontWeight="Bold" Foreground="#FF334155" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="#FFF8FAFC" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PrevSlideButton" Grid.Column="0" Content="PREV (P)" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,4,0" Click="PrevSlideButton_Click" />
                            <Button x:Name="NextSlideButton" Grid.Column="1" Content="NEXT (N)" Style="{StaticResource BroadcastPrimaryButtonStyle}" Margin="4,0,0,0" Click="NextSlideButton_Click" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ConsoleSlideList" BorderThickness="0" Background="#FFFFFFFF" SelectionChanged="ConsoleSlideList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,1"/>
                                <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                                <Setter Property="Background" Value="#FFFFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFF8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFEFF6FF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF2563EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Index}" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding SlideType}" FontSize="9" FontWeight="Bold" Foreground="#FF15803D" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FF1E293B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Column 2: Quizmaster Prompter & Live Controls -->
            <Border Grid.Column="1" BorderBrush="#FFD6DEE8" BorderThickness="0,0,1,0" Background="#FFFFFFFF">
                <DockPanel>
                    <!-- Floating Restore Pills when panels are collapsed -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,0">
                        <Button x:Name="ExpandLeftButton" Content="SHOW OUTLINE" DockPanel.Dock="Left" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Style="{StaticResource BroadcastBlueTintButtonStyle}" Visibility="Collapsed" Click="ExpandLeftButton_Click" Margin="12,0,0,0" ToolTip="Expand Outline Panel (Ctrl+[)" />
                        <Button x:Name="ExpandRightButton" Content="SHOW TEAMS" DockPanel.Dock="Right" Height="24" Padding="10,0" FontSize="11" FontWeight="Bold" Style="{StaticResource BroadcastBlueTintButtonStyle}" Visibility="Collapsed" Click="ExpandRightButton_Click" Margin="0,0,12,0" ToolTip="Expand Teams Panel (Ctrl+])" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,14">
                        
                        <!-- Top Metadata & State Bar -->
                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <WrapPanel Margin="0,0,0,6">
                                        <Border x:Name="ConsoleRoundBadge" Background="#FFE0F2FE" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="ConsoleRoundText" Text="General" FontSize="10" FontWeight="Bold" Foreground="#FF0369A1" />
                                        </Border>
                                        <Border Background="#FFDCFCE7" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock x:Name="ConsoleSlideType" Text="Question" FontSize="10" FontWeight="Bold" Foreground="#FF15803D" />
                                        </Border>
                                        <Border Background="#FFFEF3C7" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="ConsolePointsBadge" Text="10 Points" FontSize="10" FontWeight="Bold" Foreground="#FFB45309" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock x:Name="ConsoleSlideTitle" FontSize="20" FontWeight="Bold" Foreground="#FF1E293B" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Big Digital Countdown Timer with 4-button quick bar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#FF0F172A" CornerRadius="8" Padding="14,6" Margin="12,0,8,0">
                                        <TextBlock x:Name="ConsoleTimerLabel" Text="00:00" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="#FF38BDF8" VerticalAlignment="Center" />
                                    </Border>
                                    <UniformGrid Columns="2" Rows="2" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Button x:Name="TimerStartButton" Content="▶" Width="38" Height="26" Margin="1" Padding="0" Style="{StaticResource BroadcastSuccessButtonStyle}" Click="TimerStartButton_Click" ToolTip="Start / Resume Timer (Space)" />
                                        <Button x:Name="TimerPauseButton" Content="❚❚" Width="38" Height="26" Margin="1" Padding="0" FontSize="11" FontWeight="Bold" Style="{StaticResource BroadcastWarningButtonStyle}" Click="TimerPauseButton_Click" ToolTip="Pause Timer (Space)" />
                                        <Button x:Name="TimerResetButton" Content="↺" Width="38" Height="26" Margin="1" Padding="0" FontSize="12" Style="{StaticResource BroadcastNeutralButtonStyle}" Click="TimerResetButton_Click" ToolTip="Reset Timer back to full slide duration" />
                                        <Button x:Name="TimerAdd15Button" Content="+15s" Width="38" Height="26" Margin="1" Padding="0" FontSize="10" FontWeight="SemiBold" Style="{StaticResource BroadcastBlueTintButtonStyle}" Click="TimerAdd15Button_Click" ToolTip="Add +15 seconds to remaining time" />
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Emergency Stage Blackout Banner -->
                        <Border x:Name="StageBlackoutPrompterBanner" Background="#FF1E293B" BorderBrush="#FFDC2626" BorderThickness="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                            <DockPanel>
                                <Button Content="RESUME STAGE (B)" DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Background="#FFDC2626" BorderBrush="#FFB91C1C" Foreground="#FFFFFFFF" FontWeight="Bold" Padding="12,0" Click="BlackoutToggleButton_Click" />
                                <TextBlock Text="STAGE BLACKOUT ACTIVE · AUDIENCE SCREEN IS BLACK · PRESS 'B' TO RESUME" FontSize="12" FontWeight="Bold" Foreground="#FFFCA5A5" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Rapid Fire Barrage Controller Banner -->
                        <Border x:Name="RapidFireBanner" Background="#FFF43F5E" BorderBrush="#FFE11D48" BorderThickness="2" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#FFFFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="60s RAPID FIRE BARRAGE" FontSize="11" FontWeight="Bold" Foreground="#FFE11D48" />
                                        </Border>
                                        <TextBlock x:Name="RapidFireTeamLabel" Text="ACTIVE TEAM: TEAM 1" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="RapidFireStatsLabel" Text="Attempted: 0 | Correct: 0 | Points: +0 | [ENTER] = Correct (+Advance) | [SPACE] = Pass (0 pts +Advance)" FontSize="11" Foreground="#FFFFE4E6" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#88000000" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock x:Name="RapidFireClockLabel" Text="60" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                    </Border>
                                    <Button x:Name="StopRapidFireButton" Content="STOP BARRAGE" Style="{StaticResource ToolbarButtonStyle}" Background="#FF881337" BorderBrush="#FF4C0519" Foreground="#FFFFFFFF" FontWeight="Bold" Padding="10,4" Click="StopRapidFireButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Floor / Turn & Pass Indicator Banner -->
                        <Border x:Name="TurnBanner" Background="#FFFEF9C3" BorderBrush="#FFFDE047" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TurnStatusLabel" Text="ACTIVE FLOOR: TEAM 1" FontSize="13" FontWeight="Bold" Foreground="#FF854D0E" />
                                    <TextBlock x:Name="TurnDetailsLabel" Text="Direct question · Worth 10 pts · Can pass if missed" FontSize="11" Foreground="#FFA16207" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="DismissBuzzButton" Content="DISMISS BUZZ" Style="{StaticResource ToolbarButtonStyle}" Background="#FFE11D48" BorderBrush="#FFBE123C" Foreground="#FFFFFFFF" Padding="12,4" Margin="0,0,6,0" Click="DismissBuzzButton_Click" ToolTip="Dismiss active false buzz without penalty (Backspace)" Visibility="Collapsed" />
                                    <Button x:Name="PassButton" Grid.Column="1" Content="PASS (S)" Style="{StaticResource ToolbarButtonStyle}" Background="#FFF59E0B" BorderBrush="#FFD97706" Foreground="#FFFFFFFF" Padding="14,4" Click="PassButton_Click" ToolTip="Pass / bounce question to next team in turn (Shortcut: S)" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Media Preview & Transport (Host View) -->
                        <Border x:Name="ConsoleMediaPanel" Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,12" HorizontalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <Image x:Name="ConsoleMediaImage" MaxHeight="160" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <StackPanel x:Name="MediaTransportControls" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Button x:Name="MediaPlayPauseButton" Content="PLAY (M)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF2563EB" BorderBrush="#FF1D4ED8" Foreground="#FFFFFFFF" Width="95" Margin="0,0,6,0" Click="MediaPlayPauseButton_Click" ToolTip="Play or pause media on stage (M)" />
                                    <Button x:Name="MediaReplayButton" Content="REPLAY" Style="{StaticResource ToolbarButtonStyle}" Width="80" Margin="0,0,10,0" Click="MediaReplayButton_Click" ToolTip="Replay media clip from beginning" />
                                    <TextBlock Text="Vol:" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider x:Name="MediaVolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="MediaVolumeSlider_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Question Content & Options -->
                        <TextBlock x:Name="ConsoleSlideContent" FontSize="16" Foreground="#FF334155" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <TextBlock x:Name="ConsoleSlideOptions" FontSize="14" Foreground="#FF1E293B" Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="24" />

                        <!-- Secret Host Prompter & Trivia (Host Only) -->
                        <Border Background="#FFF1F5F9" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SECRET HOST PROMPTER &amp; ANSWER KEY" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,6" />
                                <TextBlock x:Name="ConsoleAnswerKey" FontSize="15" FontWeight="Bold" Foreground="#FF15803D" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock x:Name="ConsoleAlternateAnswers" FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock x:Name="ConsoleExplanation" FontSize="12" FontStyle="Italic" Foreground="#FF334155" TextWrapping="Wrap" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button x:Name="RevealClueButton" Content="REVEAL NEXT CLUE" Style="{StaticResource ToolbarButtonStyle}" Background="#FFFEF08A" BorderBrush="#FFFACC15" Foreground="#FF854D0E" Padding="10,2" DockPanel.Dock="Left" Click="RevealClueButton_Click" Visibility="Collapsed" />
                                    <TextBlock x:Name="ClueStatusLabel" FontSize="11" FontWeight="SemiBold" Foreground="#FF854D0E" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- Directives Prompter Panel (Prompt On / Do Not Accept) -->
                                <StackPanel x:Name="ConsoleDirectivesPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Border x:Name="PromptOnBadgeBorder" Background="#FFFEF3C7" BorderBrush="#FFF59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4" Visibility="Collapsed">
                                        <DockPanel LastChildFill="True">
                                            <Border Background="#FFF59E0B" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="PROMPT ON" FontSize="9" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                            </Border>
                                            <TextBlock x:Name="ConsolePromptOnText" FontSize="12" FontWeight="SemiBold" Foreground="#FF92400E" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Border x:Name="DoNotAcceptBadgeBorder" Background="#FFFEE2E2" BorderBrush="#FFEF4444" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,2" Visibility="Collapsed">
                                        <DockPanel LastChildFill="True">
                                            <Border Background="#FFEF4444" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                <TextBlock Text="DO NOT ACCEPT" FontSize="9" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                            </Border>
                                            <TextBlock x:Name="ConsoleDoNotAcceptText" FontSize="12" FontWeight="SemiBold" Foreground="#FF991B1B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Answer Input & Scoring Controls -->
                        <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="TEAM RESPONSE &amp; ADJUDICATION" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,6" />

                                <!-- Quick Choice Buttons (A, B, C, D / True, False) -->
                                <StackPanel x:Name="QuickOptionBar" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="Quick Choice:" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="QuickOptionA" Content="A" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionB" Content="B" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionC" Content="C" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionD" Content="D" Width="44" Height="30" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click"/>
                                    <Button x:Name="QuickOptionTrue" Content="TRUE" Height="30" Padding="10,0" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click" Visibility="Collapsed"/>
                                    <Button x:Name="QuickOptionFalse" Content="FALSE" Height="30" Padding="10,0" FontWeight="Bold" Margin="0,0,6,0" Style="{StaticResource ToolbarButtonStyle}" Click="QuickOptionButton_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="SubmitAnswerButton" Content="EVALUATE" Style="{StaticResource ToolbarButtonStyle}" Width="90" DockPanel.Dock="Right" Click="SubmitAnswerButton_Click" Margin="8,0,0,0" />
                                    <TextBox x:Name="ConsoleAnswerEditor" Height="32" FontSize="13" Padding="8,4" VerticalContentAlignment="Center" ToolTip="Enter or verify team's submitted response" />
                                </DockPanel>

                                <!-- 1-Click Scoring Bar -->
                                <WrapPanel>
                                    <Button x:Name="MarkCorrectButton" Content="MARK CORRECT (C)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF22C55E" BorderBrush="#FF16A34A" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="MarkCorrectButton_Click" />
                                    <Button x:Name="MarkIncorrectButton" Content="MARK WRONG (X)" Style="{StaticResource ToolbarButtonStyle}" Background="#FFEF4444" BorderBrush="#FFDC2626" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="MarkIncorrectButton_Click" />
                                    <Button x:Name="UndoScoreButton" Content="UNDO (Ctrl+Z)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF475569" BorderBrush="#FF334155" Foreground="#FFFFFFFF" Margin="0,0,8,6" Click="UndoScoreButton_Click" IsEnabled="False" ToolTip="Revert last scored answer (Ctrl+Z)" />
                                    <Button x:Name="RevealAnswerButton" Content="REVEAL ON STAGE (R)" Style="{StaticResource ToolbarButtonStyle}" Background="#FF3B82F6" BorderBrush="#FF2563EB" Foreground="#FFFFFFFF" Padding="14,0" Margin="0,0,8,6" Click="RevealAnswerButton_Click" />
                                    <Button x:Name="AcceptBuzzButton" Content="MANUAL BUZZ" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,6" Click="AcceptBuzzButton_Click" ToolTip="Register a buzz for the team currently selected in the team list" />
                                    <Button x:Name="OverrideScoreButton" Content="ADJUDICATE / OVERRIDE" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,6" Click="OverrideScoreButton_Click" />
                                </WrapPanel>

                                <!-- Override Sub-panel -->
                                <StackPanel x:Name="OverrideReasonPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Adjudication Reason:" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,4" />
                                            <TextBox x:Name="OverrideReasonEditor" Height="28" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="New Points / Total:" FontSize="10" FontWeight="Bold" Foreground="#FF475569" Margin="0,0,0,4" />
                                                    <TextBox x:Name="OverrideTotalEditor" Height="28" Width="100" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="APPLY ADJUDICATION" Style="{StaticResource ToolbarButtonStyle}" Background="#FF059669" BorderBrush="#FF047857" Foreground="#FFFFFFFF" Margin="0,0,8,0" Click="ApplyOverrideButton_Click" />
                                                <Button Content="CANCEL" Style="{StaticResource ToolbarButtonStyle}" Click="CancelOverrideButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 3: Live Scoreboard & Buzzer Queue -->
            <Border Grid.Column="2" Background="#FFF4F6F8">
                <DockPanel>
                    
                    <!-- Buzz Queue Banner -->
                    <Border DockPanel.Dock="Top" Background="#FFF8FAFC" BorderBrush="#FFD6DEE8" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>
                            <Button x:Name="CollapseRightButton" Content="&gt;" DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Style="{StaticResource BroadcastNeutralButtonStyle}" Click="CollapseRightButton_Click" ToolTip="Collapse Teams Panel (Ctrl+])" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BUZZER QUEUE &amp; TEAMS" FontSize="11" FontWeight="Bold" Foreground="#FF334155" />
                                <TextBlock Text="Press keys 1-9 on keyboard to register team buzz" FontSize="10" Foreground="#FF64748B" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Active Buzz Queue Box -->
                    <Border DockPanel.Dock="Top" x:Name="BuzzQueueContainer" Background="#FFFEF2F2" BorderBrush="#FFFECACA" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
                        <DockPanel>
                            <Button Content="CLEAR QUEUE" DockPanel.Dock="Right" Height="24" Padding="8,0" Style="{StaticResource BroadcastDangerButtonStyle}" Click="ClearQueueButton_Click" ToolTip="Clear active buzz queue and let teams re-buzz" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE BUZZ QUEUE" FontSize="10" FontWeight="Bold" Foreground="#FFB91C1C" />
                                <TextBlock x:Name="BuzzQueueListLabel" Text="No active buzzes" FontSize="12" FontWeight="SemiBold" Foreground="#FF991B1B" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Chit Pounce Submissions Panel -->
                    <Border DockPanel.Dock="Top" x:Name="PounceQueuePanel" Background="#FFFFFBEB" BorderBrush="#FFFDE68A" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="ClearPouncesButton" Content="CLEAR POUNCES" DockPanel.Dock="Right" Height="24" Padding="8,0" Style="{StaticResource BroadcastWarningButtonStyle}" Click="ClearPouncesButton_Click" ToolTip="Clear pounce submissions queue for next question" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CHIT POUNCE QUEUE" FontSize="11" FontWeight="Bold" Foreground="#FF92400E" />
                                    <Border x:Name="PounceCountBadge" Background="#FFD97706" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                        <TextBlock x:Name="PounceCountText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl x:Name="PounceItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFFFF" BorderBrush="#FFFDE68A" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding TeamName}" FontSize="12" FontWeight="Bold" Foreground="#FF1E293B" />
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Answer}" FontSize="13" FontWeight="SemiBold" Foreground="#FF92400E" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Button Content="{Binding CorrectButtonLabel}" Tag="{Binding}" Style="{StaticResource BroadcastSuccessButtonStyle}" Height="24" Padding="8,0" Margin="0,0,4,0" Click="PounceCorrectButton_Click" IsEnabled="{Binding CanEvaluate}" />
                                                    <Button Content="{Binding IncorrectButtonLabel}" Tag="{Binding}" Style="{StaticResource BroadcastDangerButtonStyle}" Height="24" Padding="8,0" Click="PounceIncorrectButton_Click" IsEnabled="{Binding CanEvaluate}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Team Score List -->
                    <ListBox x:Name="ConsoleTeamList" BorderThickness="0" Background="#FFF4F6F8" Padding="8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TeamCardContainer" Background="Transparent" CornerRadius="14">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TeamCardContainer" Property="Background" Value="#0C005A9C"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TeamCardContainer" Property="Background" Value="#1A005A9C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFFFF" BorderBrush="{Binding CardBorderBrush}" BorderThickness="2" CornerRadius="14" Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: Initial Badge, Name & Status, Rank/Lead Badges -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Circular Badge -->
                                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="{Binding CardBorderBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Team Name and Buzz Status -->
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding QuickKey}" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Team}" FontSize="13" FontWeight="Bold" Foreground="#FF0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FFE11D48" Visibility="{Binding StatusVisibility}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Rank and Leading Badges -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#FFE8EEF5" CornerRadius="10" Padding="7,3" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Rank}" FontSize="10" FontWeight="Bold" Foreground="#FF334155" />
                                                </Border>
                                                <Border Visibility="{Binding LeadVisibility}" Background="#FFFFE8A3" CornerRadius="10" Padding="7,3">
                                                    <TextBlock Text="LEADING" FontSize="9" FontWeight="Bold" Foreground="#FF493600" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Bottom Row: Digital Monospace Score -->
                                        <DockPanel Grid.Row="1" Margin="38,4,0,0">
                                            <TextBlock Text="SCORE" FontSize="10" FontWeight="Bold" Foreground="#FF64748B" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Score}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="{Binding CardBorderBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#FFF8FAFC" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0" Padding="12,7">
            <TextBlock x:Name="ConsoleStatusText" Text="Ready" FontSize="11" Foreground="#FF475569" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
