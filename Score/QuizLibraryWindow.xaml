<Window x:Class="Score.QuizLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Library · QuizScore Live"
        Width="1080" Height="720"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Deck Card Surface -->
        <Style x:Key="DeckCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect" Value="{StaticResource PanelGlowEffect}"/>
        </Style>

        <!-- Create New Button (prominent indigo) -->
        <Style x:Key="CreateButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#FF4F46E5"/>
            <Setter Property="BorderBrush" Value="#FF4338CA"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══ HEADER BAR ═══ -->
        <Border DockPanel.Dock="Top" Background="#FF0F172A" Padding="24,12"
                Effect="{StaticResource HeaderGlowEffect}">
            <DockPanel>
                <!-- Right: Create button -->
                <Button x:Name="CreateNewButton" DockPanel.Dock="Right"
                        Style="{StaticResource CreateButton}"
                        Click="CreateNewButton_Click"
                        Content="➕  CREATE NEW QUIZ"/>

                <!-- Left: Title & Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF4F46E5" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                            <TextBlock Text="✦" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="QUIZ LIBRARY &amp; CONDUCT DESK"
                                   FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Select a quiz to conduct live on stage, edit questions in studio, or create a brand new deck."
                               FontSize="11" Foreground="#FF94A3B8" Margin="34,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ TOOLBAR (Search + Sort) ═══ -->
        <Border DockPanel.Dock="Top" Background="#FFFFFFFF"
                BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1"
                Padding="24,10">
            <DockPanel>
                <!-- Sort selector -->
                <ComboBox x:Name="SortSelector" DockPanel.Dock="Right"
                          Style="{StaticResource ToolbarComboStyle}"
                          Width="180" Margin="12,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="SortSelector_SelectionChanged">
                    <ComboBoxItem Content="Title A–Z"/>
                    <ComboBoxItem Content="Title Z–A"/>
                    <ComboBoxItem Content="Newest First"/>
                    <ComboBoxItem Content="Oldest First"/>
                    <ComboBoxItem Content="Most Questions"/>
                    <ComboBoxItem Content="Last Conducted"/>
                </ComboBox>
                <TextBlock DockPanel.Dock="Right" Text="Sort:"
                           FontSize="11" FontWeight="SemiBold" Foreground="#FF64748B"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>

                <!-- Showcase Sample Quiz button -->
                <Button x:Name="SampleDeckToolbarButton" DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="SampleDeckToolbarButton_Click"
                        Margin="0,0,10,0" Padding="12,0"
                        Content="✦ SAMPLE QUIZ"
                        ToolTip="Load showcase sample quiz into library"/>

                <!-- Past Sessions History button -->
                <Button x:Name="HistoryToolbarButton" DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="HistoryToolbarButton_Click"
                        Margin="0,0,10,0" Padding="12,0"
                        Content="📊 PAST SESSIONS"
                        ToolTip="View history of past quiz sessions, export results, or purge test runs"/>

                <!-- Pre-flight Stage Check button -->
                <Button x:Name="PreflightCheckToolbarButton" DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="PreflightCheckToolbarButton_Click"
                        Margin="0,0,14,0" Padding="12,0"
                        Content="🔍 PRE-FLIGHT CHECK"
                        ToolTip="Run live stage readiness check on the current quiz deck"/>

                <!-- Search box with placeholder watermark -->
                <Grid MaxWidth="400" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource ToolbarTextStyle}"
                             TextChanged="SearchBox_TextChanged"
                             Width="360" Padding="30,0,10,0"/>
                    <TextBlock Text="🔍" FontSize="12" Foreground="#FF94A3B8"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search quizzes by title or description…"
                               FontSize="11" Foreground="#FF94A3B8"
                               Margin="32,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══ FOOTER / PAGINATION ═══ -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFFFF"
                BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0"
                Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PrevPageButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="◀ Previous" Margin="0,0,6,0"
                            Click="PrevPageButton_Click"/>
                    <Border Background="#FFF1F5F9" CornerRadius="6" Padding="12,4" Margin="4,0">
                        <TextBlock x:Name="PageInfoText"
                                   Text="Page 1 of 1"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#FF1E293B"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="NextPageButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Content="Next ▶" Margin="6,0,0,0"
                            Click="NextPageButton_Click"/>
                </StackPanel>

                <TextBlock x:Name="SummaryInfoText"
                           Text="Showing 6 quizzes per page"
                           FontSize="11" Foreground="#FF64748B"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Margin="16,16,16,0">
            <!-- Empty-state overlay -->
            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="No Quiz Decks Found"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#FF1E293B" HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <TextBlock x:Name="EmptyStateSubtext"
                           Text="Click 'CREATE NEW QUIZ' to create your first quiz deck."
                           FontSize="12" Foreground="#FF64748B"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource CreateButton}"
                            Click="CreateNewButton_Click"
                            Content="➕  CREATE FIRST QUIZ"
                            Margin="0,0,10,0"/>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="SampleDeckToolbarButton_Click"
                            Content="✦ LOAD SHOWCASE SAMPLE QUIZ"
                            Height="36" Padding="16,0" Background="#FF4F46E5" Foreground="#FFFFFFFF" BorderBrush="#FF4338CA"/>
                </StackPanel>
            </StackPanel>

            <!-- Card gallery -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,0">
                <WrapPanel x:Name="DeckCardsPanel"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>