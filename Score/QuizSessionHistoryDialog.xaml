<Window x:Class="Score.QuizSessionHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Past Quiz Sessions &amp; Score History"
        Width="920" Height="560"
        MinWidth="750" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <DockPanel>
        <!-- Top Banner -->
        <Border DockPanel.Dock="Top" Background="#FF0F172A" Padding="20,14">
            <DockPanel>
                <Button x:Name="PurgeTestRunsButton" DockPanel.Dock="Right"
                        Content="PURGE ALL TEST RUNS"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#FFDC2626" BorderBrush="#FFB91C1C" Foreground="#FFFFFFFF"
                        FontWeight="Bold" Height="32" Padding="14,0"
                        Click="PurgeTestRunsButton_Click"
                        ToolTip="Delete completed and abandoned test sessions to clean the database" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PAST QUIZ SESSIONS &amp; RESULTS" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" />
                    <TextBlock Text="Review previous live quiz performances, export results to CSV, or clear out past test scores." FontSize="11" Foreground="#FF94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <Button x:Name="ExportCsvButton" DockPanel.Dock="Left"
                        Content="📥 EXPORT SELECTED TO CSV"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#FF059669" BorderBrush="#FF047857" Foreground="#FFFFFFFF"
                        FontWeight="Bold" Height="32" Padding="14,0"
                        Click="ExportCsvButton_Click" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right"
                        Content="CLOSE" Width="90" Height="32"
                        Style="{StaticResource ToolbarButtonStyle}"
                        IsCancel="True" Click="CloseButton_Click" />
                <TextBlock x:Name="HistoryCountText" Text="Loading sessions…" FontSize="11" Foreground="#FF64748B" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Session List Grid -->
        <DataGrid x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFFFFFFF" BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#FFF1F5F9" RowHeight="36"
                  SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FFF1F5F9"/>
                    <Setter Property="Foreground" Value="#FF334155"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SessionId}" Width="60" />
                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="150" />
                <DataGridTextColumn Header="Quiz Deck Title" Binding="{Binding DeckTitle}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="Teams" Binding="{Binding TeamsSummary}" Width="160" />
                <DataGridTextColumn Header="Responses" Binding="{Binding ResponseCount}" Width="85" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
