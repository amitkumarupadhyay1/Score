<Window x:Class="Score.QuizAudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Live Stage Presentation"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B132B"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Cursor="None">
    <Grid Background="#FF0B132B">
        <!-- Scale to fit 1920x1080 design canvas cleanly on 4K, 1080p, and 4:3 / 16:10 projectors -->
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="AudienceStageRootGrid" Width="1920" Height="1080" Background="#FF0B132B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Deck Title, Round, and Giant Countdown Clock -->
                <Border x:Name="AudienceHeaderBorder" Grid.Row="0" Background="#FF1C2541" Padding="48,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="AudienceDeckTitle" Text="QuizScore Live" FontSize="44" FontWeight="Bold" Foreground="#FFFFFFFF" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border x:Name="AudienceRoundBorder" Background="#FF3A506B" CornerRadius="6" Padding="14,4" Margin="0,0,12,0">
                                    <TextBlock x:Name="AudienceRoundName" Text="ROUND 1" FontSize="20" FontWeight="Bold" Foreground="#FF6FFFE9" />
                                </Border>
                                <Border x:Name="AudiencePointsBorder" Background="#FF1B4332" CornerRadius="6" Padding="14,4">
                                    <TextBlock x:Name="AudiencePointsLabel" Text="10 POINTS" FontSize="20" FontWeight="Bold" Foreground="#FF95D5B2" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Stage Giant Countdown Timer (Scalable Viewbox) -->
                        <Border x:Name="AudienceTimerBorder" Grid.Column="1" Background="#FF0B132B" CornerRadius="16" Padding="24,6" Margin="24,0,0,0" MinWidth="220" Height="84" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" MaxHeight="72">
                                <TextBlock x:Name="AudienceTimerLabel" Text="00:00" FontFamily="Consolas" FontSize="64" FontWeight="Bold" Foreground="#FF6FFFE9" VerticalAlignment="Center" />
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Presentation Area -->
                <Border Grid.Row="1" Background="#FF0B132B" Padding="36,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Question / Content Card -->
                        <Border x:Name="AudienceQuestionContentBorder" Grid.Column="0" Background="#FFFFFFFF" CornerRadius="24" Padding="44" Margin="10" Effect="{StaticResource PanelGlowEffect}">
                            <ScrollViewer x:Name="AudienceQuestionContentScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="AudienceSlideType" Text="QUESTION" FontSize="22" FontWeight="Bold" Foreground="#FF0284C7" Margin="0,0,0,12" />
                                    <TextBlock x:Name="AudienceSlideTitle" Text="Welcome to the Quiz" FontSize="48" FontWeight="Bold" Foreground="#FF0F172A" TextWrapping="Wrap" Margin="0,0,0,18" />
                                    <TextBlock x:Name="AudienceSlideContent" FontSize="32" Foreground="#FF334155" TextWrapping="Wrap" LineHeight="46" Margin="0,0,0,24" />

                                    <!-- Structured Stage Rules Matrix Card (When SlideType == Instruction and HasStructuredRules) -->
                                    <Border x:Name="AudienceStageRulesPanel" Background="#FFF8FAFC" BorderBrush="#FFCBD5E1" BorderThickness="2.5" CornerRadius="20" Padding="36,30" Margin="0,10,0,24" Visibility="Collapsed" Effect="{StaticResource PanelGlowEffect}">
                                        <StackPanel>
                                            <!-- Mode Header & Conferring Directive -->
                                            <Grid Margin="0,0,0,24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="StageRulesModeBadgeBorder" Grid.Column="0" Background="#FF1E293B" CornerRadius="10" Padding="20,10" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="StageRulesModeBadgeText" Text="DIRECT WITH BOUNCE" FontSize="26" FontWeight="Black" Foreground="#FFFFFFFF" />
                                                </Border>
                                                <Border x:Name="StageRulesConferringBorder" Grid.Column="1" Background="#FFDCFCE7" BorderBrush="#FF86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="16,10" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="StageRulesConferringText" Text="👥 CONFERRING ALLOWED" FontSize="20" FontWeight="Bold" Foreground="#FF15803D" />
                                                </Border>
                                            </Grid>

                                            <!-- Matrix Scoring & Time Limit Chips -->
                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                <!-- Direct Points Chip -->
                                                <Border x:Name="StageRulesDirectChip" Background="#FFDCFCE7" BorderBrush="#FF86EFAC" BorderThickness="2" CornerRadius="14" Padding="24,14" Margin="0,0,18,12" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock x:Name="StageRulesDirectLabel" Text="DIRECT QUESTION" FontSize="14" FontWeight="Bold" Foreground="#FF166534" />
                                                        <TextBlock x:Name="StageRulesDirectPointsText" Text="+10 PTS" FontSize="36" FontWeight="Black" Foreground="#FF15803D" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Bounce Points Chip -->
                                                <Border x:Name="StageRulesBounceChip" Background="#FFE0F2FE" BorderBrush="#FF7DD3FC" BorderThickness="2" CornerRadius="14" Padding="24,14" Margin="0,0,18,12" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock x:Name="StageRulesBounceLabel" Text="BOUNCE / PASS" FontSize="14" FontWeight="Bold" Foreground="#FF0369A1" />
                                                        <TextBlock x:Name="StageRulesBouncePointsText" Text="+5 PTS" FontSize="36" FontWeight="Black" Foreground="#FF0284C7" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Penalty Points Chip -->
                                                <Border x:Name="StageRulesPenaltyChip" Background="#FFFEE2E2" BorderBrush="#FFFCA5A5" BorderThickness="2" CornerRadius="14" Padding="24,14" Margin="0,0,18,12" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock x:Name="StageRulesPenaltyLabel" Text="WRONG PENALTY" FontSize="14" FontWeight="Bold" Foreground="#FF991B1B" />
                                                        <TextBlock x:Name="StageRulesPenaltyPointsText" Text="-0 PTS" FontSize="36" FontWeight="Black" Foreground="#FFDC2626" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Time Limit Clock Chip -->
                                                <Border x:Name="StageRulesTimerChip" Background="#FFFEF3C7" BorderBrush="#FFFCD34D" BorderThickness="2" CornerRadius="14" Padding="24,14" Margin="0,0,18,12" MinWidth="180">
                                                    <StackPanel>
                                                        <TextBlock x:Name="StageRulesTimerLabel" Text="TIME LIMIT" FontSize="14" FontWeight="Bold" Foreground="#FF92400E" />
                                                        <TextBlock x:Name="StageRulesTimeLimitText" Text="15s Clock" FontSize="36" FontWeight="Black" Foreground="#FFD97706" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Directive / Custom Notes Banner -->
                                            <Border x:Name="StageRulesNotesBorder" Background="#FFF1F5F9" CornerRadius="10" Padding="18,12" Visibility="Collapsed">
                                                <TextBlock x:Name="StageRulesNotesText" FontSize="20" FontWeight="SemiBold" Foreground="#FF334155" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Options (MCQ / MultiSelect / TrueFalse) with Highlight Support -->
                                    <ItemsControl x:Name="AudienceOptions" Margin="0,0,0,20">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" CornerRadius="14" Padding="24,14" Margin="0,0,0,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="{Binding BadgeBackground}" CornerRadius="8" Width="44" Height="44" Margin="0,0,18,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Letter}" FontSize="24" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="30" FontWeight="{Binding FontWeight}" Foreground="{Binding Foreground}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Checkmark}" FontSize="24" FontWeight="Bold" Foreground="{Binding CheckmarkForeground}" Margin="16,0,6,0" VerticalAlignment="Center" Visibility="{Binding CheckmarkVisibility}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Progressive Clues / Hints Box (When revealed) -->
                                    <Border x:Name="AudienceCluesPanel" Background="#FFFEF9C3" BorderBrush="#FFFACC15" BorderThickness="2" CornerRadius="14" Padding="22" Margin="0,0,0,20" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="💡 CLUES REVEALED" FontSize="20" FontWeight="Bold" Foreground="#FF854D0E" Margin="0,0,0,10" />
                                            <ItemsControl x:Name="AudienceCluesList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="26" FontWeight="SemiBold" Foreground="#FF713F12" Margin="0,4,0,6" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Answer Reveal Banner (Explanation secret host notes removed) -->
                                    <Border x:Name="AudienceAnswerContainer" Background="#FFDCFCE7" BorderBrush="#FF86EFAC" BorderThickness="3" CornerRadius="16" Padding="26,18" Margin="0,12,0,0" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="CORRECT ANSWER" FontSize="18" FontWeight="Bold" Foreground="#FF15803D" Margin="0,0,0,6" />
                                            <TextBlock x:Name="AudienceAnswerText" FontSize="40" FontWeight="Bold" Foreground="#FF166534" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Media Display Panel -->
                        <Border Grid.Column="1" x:Name="AudienceMediaPanel" Background="#FF1C2541" CornerRadius="24" Margin="18,10,10,10" Width="600" Visibility="Collapsed">
                            <Grid Margin="16">
                                <Image x:Name="AudienceImage" Stretch="Uniform" Visibility="Collapsed" />
                                <MediaElement x:Name="AudienceMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Big Buzz / Pass Indicator Overlay Banner -->
                <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,32,0,0" Panel.ZIndex="50">
                    <Border x:Name="AudienceBuzzBorder" Background="#FFE11D48" BorderBrush="#FFF43F5E" BorderThickness="3" CornerRadius="20" Padding="48,18" Visibility="Collapsed" Effect="{StaticResource HeaderGlowEffect}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BuzzScaleTransform" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="AudienceBuzzIndicator" Text="🚨 TEAM 1 BUZZED IN! 🚨" FontSize="38" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Footer: Live Tournament Scoreboard -->
                <Border x:Name="AudienceScoreboardBorder" Grid.Row="2" Background="#FF1C2541" Padding="36,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="AudienceStatusText" Foreground="#FFFBBF24" FontSize="20" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="LIVE LEADERBOARD" FontSize="16" FontWeight="Bold" Foreground="#FF94A3B8" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AudienceScoreboard">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF0B132B" CornerRadius="10" Padding="16,8" Margin="0,0,16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Team}" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFFFF" />
                                                <TextBlock Text="{Binding Score}" FontSize="26" FontFamily="Consolas" FontWeight="Bold" Foreground="#FF6FFFE9" Margin="14,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="QuizScore Live" FontSize="20" FontWeight="Bold" Foreground="#FF475569" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <!-- Full-Screen Inter-Round Tournament Standings Overlay -->
                <Border x:Name="AudienceInterRoundPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="60" Background="#FF0B132B" Padding="80,48" Visibility="Collapsed">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1500" Width="1440">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Transition Banner -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border x:Name="InterRoundBadgeBorder" Background="#FF1E293B" CornerRadius="10" Padding="24,8" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock x:Name="InterRoundTransitionBadge" Text="ROUND COMPLETE · STANDINGS" FontSize="22" FontWeight="Bold" Foreground="#FF38BDF8" />
                            </Border>
                            <TextBlock x:Name="InterRoundCompletedTitle" Text="ROUND 1 CONCLUDED" FontSize="52" FontWeight="Black" Foreground="#FFFFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock x:Name="InterRoundNextTitle" Text="Up Next: Round 2" FontSize="28" FontWeight="SemiBold" Foreground="#FF94A3B8" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Full-Screen Standings Card Table -->
                        <Border x:Name="InterRoundTableCard" Grid.Row="1" Background="#FF1C2541" CornerRadius="24" Padding="36,24" Effect="{StaticResource PanelGlowEffect}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                <ItemsControl x:Name="InterRoundStandingsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}" BorderBrush="{Binding RowBorderBrush}" BorderThickness="1.5" CornerRadius="14" Padding="24,14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="{Binding RankBadgeBackground}" CornerRadius="10" Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RankText}" FontSize="26" FontWeight="Black" Foreground="{Binding RankBadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding TeamName}" FontSize="32" FontWeight="Bold" Foreground="{Binding TeamNameForeground}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />

                                                    <Border Grid.Column="2" Background="{Binding ShiftBackground}" CornerRadius="8" Padding="14,6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ShiftText}" FontSize="20" FontWeight="Bold" Foreground="{Binding ShiftForeground}" />
                                                    </Border>

                                                    <TextBlock Grid.Column="3" Text="{Binding ScoreText}" FontSize="36" FontFamily="Consolas" FontWeight="Black" Foreground="{Binding ScoreForeground}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Grid.Row="2" Text="Live Tournament Engine · Official Standings" FontSize="18" FontWeight="SemiBold" Foreground="#FF64748B" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Stage Curtain Blackout Mode Overlay -->
        <Grid x:Name="BlackoutOverlay" Background="#FF000000" Visibility="Collapsed" Panel.ZIndex="100" />
    </Grid>
</Window>
