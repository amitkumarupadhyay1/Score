<Window x:Class="Score.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Score"
        mc:Ignorable="d"
        Title="INTACH Heritage Quiz Score Board" WindowState="Maximized" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF232526" Offset="0.0"/>
            <GradientStop Color="#FF414345" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="8,0,8,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBox x:Name="EventTitleEditor" Text="INTACH HERITAGE QUIZ" MaxLength="36" ToolTip="Click to edit quiz title" FontFamily="Segoe UI Black" FontSize="20" Foreground="#FFEFEFEF" Background="Transparent" BorderThickness="0" Padding="0" KeyDown="EventTitleEditor_KeyDown" LostFocus="EventTitleEditor_LostFocus" />
                <TextBlock Text="LIVE SCOREBOARD" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FFB8C0C8" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="GLOBAL" VerticalAlignment="Center" Margin="0,0,4,0" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FFB8C0C8" />
                <ComboBox x:Name="GlobalMinutesSelector" SelectedIndex="0" Width="42" Height="27" Margin="0,0,5,0" ToolTip="Global minutes">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="15" />
                    <ComboBoxItem Content="30" />
                    <ComboBoxItem Content="45" />
                    <ComboBoxItem Content="60" />
                </ComboBox>
                <TextBlock x:Name="GlobalTimerLabel" Text="--:--" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FF7CFFB2" />
                <TextBlock Text="ROUND" VerticalAlignment="Center" Margin="0,0,4,0" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FFB8C0C8" />
                <ComboBox x:Name="RoundMinutesSelector" SelectedIndex="1" Width="42" Height="27" Margin="0,0,5,0" ToolTip="Round minutes">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="10" />
                </ComboBox>
                <TextBlock x:Name="RoundTimerLabel" Text="--:--" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#FF7CFFB2" />
                <Button x:Name="StartTimerButton" Content="START" Click="StartTimerButton_Click" Margin="0,0,5,0" Padding="8,7" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#FF1C1C1C" Background="#FF7CFFB2" BorderBrush="#FFC0FFDA" BorderThickness="1" />
                <Button x:Name="PauseTimerButton" Content="PAUSE" Click="PauseTimerButton_Click" Margin="0,0,5,0" Padding="8,7" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White" Background="#FFB88632" BorderBrush="#FFE4C070" BorderThickness="1" />
                <Button x:Name="ResumeTimerButton" Content="RESUME" Click="ResumeTimerButton_Click" Margin="0,0,7,0" Padding="8,7" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="White" Background="#FF3A6F9B" BorderBrush="#FF7EAED1" BorderThickness="1" />
                <TextBlock x:Name="RoundNumberLabel" Text="ROUND 1" VerticalAlignment="Center" Margin="0,0,7,0" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FFFFD700" />
                <ComboBox x:Name="RoundCountSelector" SelectedIndex="2" SelectionChanged="RoundCountSelector_SelectionChanged" Width="45" Height="27" Margin="0,0,7,0" ToolTip="Number of rounds">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                    <ComboBoxItem Content="9" />
                    <ComboBoxItem Content="10" />
                </ComboBox>
                <Button Content="FINISH ROUND" Click="FinishRoundButton_Click" Margin="0,0,7,0" Padding="10,7" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF1C1C1C" Background="#FF7CFFB2" BorderBrush="#FFC0FFDA" BorderThickness="1" />
                <Border Background="#FF2D3338" CornerRadius="6" Padding="10,7">
                    <TextBlock Text="4 TEAMS  |  LIVE" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF7CFFB2" />
                </Border>
                <Button Content="ANNOUNCE WINNER" Click="AnnounceWinnerButton_Click" Margin="7,0,0,0" Padding="10,7" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF1C1C1C" Background="#FFFFD700" BorderBrush="#FFFFF0A0" BorderThickness="1" />
                <Button Content="RESET" Click="ResetButton_Click" Margin="7,0,0,0" Padding="10,7" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="White" Background="#FF9B3D3D" BorderBrush="#FFD06A6A" BorderThickness="1" />
                <Button Content="EXPORT LOG" Click="ExportLogButton_Click" Margin="7,0,0,0" Padding="10,7" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="White" Background="#FF3A6F9B" BorderBrush="#FF7EAED1" BorderThickness="1" />
            </StackPanel>
        </Grid>

        <!-- Team 1 -->
        <local:TeamScoreCard x:Name="Team1Card" Grid.Row="1" Grid.Column="0" 
                             TeamName="APS" DatabaseTeamName="JBA 1" ScoreColor="#FFFF007F"
                             ScoreDecreased="Card_ScoreDecreased" ScoreIncreased="Card_ScoreIncreased" TeamTimerStarted="Card_TeamTimerStarted" TeamTimerStopped="Card_TeamTimerStopped"/>

        <!-- Team 2 -->
        <local:TeamScoreCard x:Name="Team2Card" Grid.Row="1" Grid.Column="1" 
                             TeamName="Sunbeam" DatabaseTeamName="JBA 2" ScoreColor="#FF00D8FF"
                             ScoreDecreased="Card_ScoreDecreased" ScoreIncreased="Card_ScoreIncreased" TeamTimerStarted="Card_TeamTimerStarted" TeamTimerStopped="Card_TeamTimerStopped"/>

        <!-- Team 3 -->
        <local:TeamScoreCard x:Name="Team3Card" Grid.Row="2" Grid.Column="0" 
                             TeamName="JB Academy" DatabaseTeamName="YVM 1" ScoreColor="#FF00FF80"
                             ScoreDecreased="Card_ScoreDecreased" ScoreIncreased="Card_ScoreIncreased" TeamTimerStarted="Card_TeamTimerStarted" TeamTimerStopped="Card_TeamTimerStopped"/>

        <!-- Team 4 -->
        <local:TeamScoreCard x:Name="Team4Card" Grid.Row="2" Grid.Column="1" 
                             TeamName="AIS" DatabaseTeamName="YVM 2" ScoreColor="#FFFFD700"
                             ScoreDecreased="Card_ScoreDecreased" ScoreIncreased="Card_ScoreIncreased" TeamTimerStarted="Card_TeamTimerStarted" TeamTimerStopped="Card_TeamTimerStopped"/>

        <Border x:Name="WinnerOverlay" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#F51C1C1C" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="WinnerContext" Text="FINAL RESULT" HorizontalAlignment="Center" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#FFFFD700" />
                <TextBlock x:Name="WinnerTitle" Text="WINNER" HorizontalAlignment="Center" Margin="0,8,0,0" FontFamily="Segoe UI Black" FontSize="52" Foreground="White" />
                <TextBlock x:Name="WinnerScore" HorizontalAlignment="Center" Margin="0,4,0,20" FontFamily="Impact" FontSize="100" Foreground="#FFFFD700" />
                <TextBlock x:Name="FinalStandings" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Segoe UI" FontSize="15" Foreground="#FFEFEFEF" TextAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="WinnerActionButton" Content="NEXT ROUND" Click="WinnerActionButton_Click" HorizontalAlignment="Center" Padding="24,12" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#FF1C1C1C" Background="#FFFFD700" BorderBrush="#FFFFF0A0" BorderThickness="1" />
            </StackPanel>
        </Border>
    </Grid>
</Window>