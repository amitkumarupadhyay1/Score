<Window x:Class="Score.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Score"
        Title="QuizScore Live" Icon="star.png" WindowState="Maximized" WindowStartupLocation="CenterScreen" MinWidth="960" MinHeight="600"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF4F6F8" Offset="0"/><GradientStop Color="#FFEFF2F5" Offset="0.48"/><GradientStop Color="#FFF4F6F8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid x:Name="RootLayout" Margin="12" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,8" CornerRadius="18" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1" Effect="{StaticResource HeaderGlowEffect}">
            <Grid x:Name="HeaderLayout" SizeChanged="HeaderLayout_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel x:Name="HeaderTitle">
                    <TextBox x:Name="EventTitleEditor" Text="QUIZ CHAMPIONSHIP" MaxLength="50" TextWrapping="Wrap" ToolTip="Event title" FontSize="21" FontWeight="Bold" Foreground="#FF172B4D" Background="Transparent" BorderThickness="0" Padding="0" KeyDown="EventTitleEditor_KeyDown" LostFocus="EventTitleEditor_LostFocus" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="RoundNumberLabel" Text="ROUND 1" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#FF172B4D"/>
                        <TextBlock x:Name="CompetitionStatusLabel" Text="READY TO START" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D"/>
                    </StackPanel>
                </StackPanel>
                <WrapPanel x:Name="HeaderControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                            <Setter Property="Padding" Value="9,0"/>
                        </Style>
                    </WrapPanel.Resources>
                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="87"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="EVENT" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GlobalTimerLabel" Grid.Column="1" Text="NO LIMIT" Margin="6,0,0,0" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF172B4D"/>
                        <TextBlock Grid.Row="1" Text="ROUND" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RoundTimerLabel" Grid.Row="1" Grid.Column="1" Text="02:00" Margin="6,0,0,0" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FF172B4D"/>
                    </Grid>
                    <Button x:Name="StartTimerButton" Content="START LIVE" Click="StartTimerButton_Click" Background="#FFD9F2E5" BorderBrush="#FFA8D9BD"/>
                    <Button x:Name="PauseTimerButton" Content="PAUSE" Click="PauseTimerButton_Click" Background="#FFFFEBC7" BorderBrush="#FFE5C98F"/>
                    <Button x:Name="ResumeTimerButton" Content="RESUME" Click="ResumeTimerButton_Click" Background="#FFDCEBFA" BorderBrush="#FFA8C5E3"/>
                    <Button x:Name="RestartTimerButton" Content="RESTART TIMERS" Click="RestartTimerButton_Click" Background="#FFE4EAF2" BorderBrush="#FFBAC8DA" ToolTip="Reset the event and round clocks, then start them again"/>
                    <Button x:Name="RoundSetupButton" MinWidth="96" Content="SHOW SETUP" Click="RoundSetupButton_Click" ToolTip="Show or hide round, time limit, and team settings"/>
                    <Button x:Name="ChimeButton" MinWidth="72" Content="SOUND ON" Click="ChimeButton_Click" ToolTip="Turn scoring and round chimes on or off"/>
                    <Border Padding="10,5" CornerRadius="12" Background="#FFF1F4F7" BorderBrush="#FFCBD5E1" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="TeamCountLabel" Text="4" FontSize="18" FontWeight="Bold" Foreground="#FF172B4D"/><TextBlock Text=" TEAMS" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D"/></StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
        <Border x:Name="RoundSetupPanel" Margin="0,8,0,0" Padding="12,8" CornerRadius="14" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="ROUND SETUP" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="FORMAT" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RoundFormatSelector" Height="34" SelectedIndex="0" Style="{StaticResource ToolbarComboStyle}" SelectionChanged="RoundFormatSelector_SelectionChanged">
                                <ComboBoxItem Content="Standard"/><ComboBoxItem Content="Rapid fire"/><ComboBoxItem Content="Buzzer"/><ComboBoxItem Content="Visual / audio"/><ComboBoxItem Content="Tie-breaker"/><ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ROUND NAME" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <TextBox x:Name="RoundLabelEditor" Height="34" Text="General Knowledge" MaxLength="40" Style="{StaticResource ToolbarTextStyle}" ToolTip="Round name, category, or question set" LostFocus="RoundLabelEditor_LostFocus"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="TIME LIMITS" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="WHOLE EVENT" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <ComboBox x:Name="GlobalMinutesSelector" Height="34" SelectedIndex="0" Style="{StaticResource ToolbarComboStyle}" ToolTip="Maximum time for the whole quiz" SelectionChanged="TimerDurationSelector_SelectionChanged"><ComboBoxItem Content="No limit"/><ComboBoxItem Content="15 min"/><ComboBoxItem Content="30 min"/><ComboBoxItem Content="45 min"/><ComboBoxItem Content="60 min"/><ComboBoxItem Content="90 min"/><ComboBoxItem Content="120 min (2 hr)"/></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="EACH ROUND" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RoundMinutesSelector" Height="34" SelectedIndex="2" Style="{StaticResource ToolbarComboStyle}" ToolTip="Maximum time for each round" SelectionChanged="TimerDurationSelector_SelectionChanged"><ComboBoxItem Content="No limit"/><ComboBoxItem Content="1 min"/><ComboBoxItem Content="2 min"/><ComboBoxItem Content="3 min"/><ComboBoxItem Content="5 min"/><ComboBoxItem Content="10 min"/></ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SESSION SETUP" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="TEAMS" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TeamCountSelector" Width="64" Height="34" SelectedIndex="2" SelectionChanged="TeamCountSelector_SelectionChanged" Style="{StaticResource ToolbarComboStyle}" ToolTip="Number of teams playing" AutomationProperties.Name="Number of teams"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/></ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TOTAL ROUNDS" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RoundCountSelector" Width="64" Height="34" SelectedIndex="2" SelectionChanged="RoundCountSelector_SelectionChanged" Style="{StaticResource ToolbarComboStyle}"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <WrapPanel Margin="4,5,4,0" Visibility="{Binding Visibility, ElementName=RoundSetupPanel}">
            <TextBlock Text="PROJECTOR THEME" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ProjectorThemeSelector" Width="145" Height="28" SelectedIndex="0" SelectionChanged="ProjectorThemeSelector_SelectionChanged" ToolTip="Projector theme, remembered for the next event" AutomationProperties.Name="Projector theme">
                <ComboBoxItem Content="Dark"/><ComboBoxItem Content="High contrast"/><ComboBoxItem Content="Light"/>
            </ComboBox>
        </WrapPanel>
        <Expander x:Name="QuestionPanel" Margin="4,5,4,0" Foreground="#FF172B4D">
            <Expander.Header><TextBlock x:Name="QuestionSummary" Text="QUESTION TIMER · ready · 00:30" FontWeight="SemiBold"/></Expander.Header>
            <WrapPanel Margin="4,4,4,0" VerticalAlignment="Center">
                <TextBlock Text="Seconds" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="QuestionSecondsSelector" Width="70" Height="32" IsEditable="True" Text="30" LostFocus="QuestionDuration_LostFocus" ToolTip="Question duration from 1 to 3600 seconds">
                    <ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="45"/><ComboBoxItem Content="60"/>
                </ComboBox>
                <Button x:Name="QuestionStartButton" Content="START QUESTION" Click="QuestionStart_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button x:Name="QuestionHoldButton" Content="HOLD" Click="QuestionHold_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button x:Name="QuestionAddButton" Content="+10 SEC" Click="QuestionAdd_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button x:Name="QuestionRestartButton" Content="RESTART QUESTION" Click="QuestionRestart_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button x:Name="QuestionNextButton" Content="NEXT QUESTION" Click="QuestionNext_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <CheckBox x:Name="QuestionLockCheckBox" Content="Lock scoring at time up" Margin="8,0,0,0" VerticalAlignment="Center" Click="QuestionLock_Click"/>
            </WrapPanel>
        </Expander>
        </StackPanel>

        <ScrollViewer x:Name="TeamCardsViewport" Grid.Row="2" Grid.RowSpan="2" Margin="0,8,0,0" SizeChanged="TeamCardsViewport_SizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
            <Grid x:Name="TeamCardsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="11,9" CornerRadius="14" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1">
            <StackPanel>
                <Border x:Name="SaveWarningPanel" Visibility="Collapsed" Background="#FFFFEBC7" Padding="8,3" Margin="0,0,0,4">
                    <DockPanel><Button x:Name="RetrySaveButton" Content="RETRY SAVE" Click="RetrySave_Click" DockPanel.Dock="Right"/>
                        <TextBlock x:Name="SaveWarningLabel" TextWrapping="Wrap" Foreground="#FF8A2600" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <DockPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Left" Text="LIVE ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,9,0"/>
                    <TextBlock x:Name="EventFeedLabel" Text="Set the teams, add player names, then start the first round." FontSize="12" Foreground="#FF172B4D" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </DockPanel>
                <WrapPanel Margin="0,4,0,0" HorizontalAlignment="Right">
                    <Button Content="UNDO LAST" Click="UndoLastScoreButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Reverse the latest score change and add an audit-log entry"/>
                    <Button x:Name="FinishRoundButton" Content="FINISH ROUND" Click="FinishRoundButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFD9F2E5" BorderBrush="#FFA8D9BD"/>
                    <Button x:Name="ReviewScoresButton" Content="REVIEW SCORES" Click="ReviewScores_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Correct a current or completed round with a reason"/>
                    <Button Content="ROUND RESULT" Click="AnnounceWinnerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFEAE2F5" BorderBrush="#FFC8B6E0" ToolTip="Preview the current round ranking without finishing the round"/>
                    <Button Content="STANDINGS" Click="ShowStandingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFDCEAF2" BorderBrush="#FFAFC8DB" ToolTip="View completed-round scores without stopping the current round"/>
                    <Button Content="EXPORT LOG" Click="ExportLogButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="ABOUT" Click="AboutButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFDCEAF2" BorderBrush="#FFAFC8DB" ToolTip="View application and developer information"/>
                    <Button x:Name="ProjectorButton" Content="PROJECTOR LIVE" Click="ProjectorButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Show the audience live round scores"/>
                    <Button x:Name="ProjectorStandingsButton" Content="PROJECTOR STANDINGS" Click="ProjectorStandingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Show ranked tournament totals to the audience"/>
                    <Button x:Name="NewGameButton" Content="NEW GAME" Click="ResetButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFFBE1E3" BorderBrush="#FFE5AEB4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="WinnerOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Background="#550E1B2A" Panel.ZIndex="10" CornerRadius="18">
            <Border HorizontalAlignment="Center" VerticalAlignment="Stretch" MaxWidth="1120" Margin="24" Padding="30,24" Background="#FFFFFFFF" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock x:Name="WinnerContext" Text="ROUND COMPLETE" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF172B4D"/>
                    <TextBlock x:Name="WinnerTitle" Text="WINNER" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="42" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Center"/>
                    <TextBlock x:Name="WinnerScore" HorizontalAlignment="Center" Margin="0,2,0,18" FontFamily="Impact" FontSize="52" Foreground="#FF172B4D" TextAlignment="Center"/>
                    <Grid x:Name="RoundResultsPanel" MinWidth="760" Margin="0,0,0,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,0,12,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D"/>
                            <TextBlock Grid.Column="1" Text="TEAM" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D"/>
                            <TextBlock Grid.Column="2" Text="ROUND SCORE" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOURNAMENT TOTAL" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="RESPONSE TIME" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="RoundResultsRows" Grid.Row="1"/>
                    </Grid>
                    <Grid x:Name="FinalStandings" MinWidth="860" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,0,14,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D"/>
                            <TextBlock Grid.Column="1" Text="TEAM" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D"/>
                            <TextBlock Grid.Column="2" Text="FINAL SCORE" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="SCORES / ROUND TIME" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TEAM TIME" FontSize="9" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="FinalStandingsRows" Grid.Row="1"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="WinnerActionButton" Content="NEXT ROUND" Click="WinnerActionButton_Click" Style="{StaticResource ToolbarButtonStyle}" Padding="24,0" Background="#FFFFE8A3" Foreground="#FF172B4D" BorderBrush="#FFFFD76A"/>
                        <StackPanel x:Name="FinalGameActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="TieBreakButton" Content="TIE-BREAK" Click="TieBreak_Click" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed"/>
                            <Button Content="REVIEW SCORES" Click="ReviewScores_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button x:Name="FinalExportButton" Content="EXPORT RESULTS" Click="ExportLogButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                            <Button x:Name="FinalNewGameButton" Content="NEW GAME" Click="ResetButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FFFBE1E3" BorderBrush="#FFE5AEB4"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="RoundSaveError" Visibility="Collapsed" Margin="0,10,0,0"
                               Foreground="#FFA61B1B" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border x:Name="AboutOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Background="#550E1B2A" Panel.ZIndex="20" CornerRadius="18">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="34" Background="#FFFFFFFF" BorderBrush="#FFB8C6D6" BorderThickness="1" CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="ABOUT THE APPLICATION" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#FF172B4D"/>
                    <TextBlock Text="QuizScore Live" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="36" FontWeight="Bold" Foreground="#FF172B4D"/>
                    <TextBlock x:Name="AboutVersionLabel" HorizontalAlignment="Center" Margin="0,4,0,24" FontSize="13" Foreground="#FF172B4D"/>
                    <Border Padding="20" Background="#FFF1F4F7" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="DESIGNED AND DEVELOPED BY" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D"/>
                            <TextBlock Text="AMIT KUMAR UPADHYAY" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="22" FontWeight="Bold" Foreground="#FF172B4D" TextAlignment="Center"/>
                            <TextBlock Text="School - JB Academy, Ayodhya" HorizontalAlignment="Center" Margin="0,7,0,0" FontSize="14" Foreground="#FF172B4D" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Live scoring, timing, standings, and audit-ready quiz records." HorizontalAlignment="Center" Margin="0,22,0,20" FontSize="12" Foreground="#FF172B4D" TextAlignment="Center"/>
                    <Button Content="CLOSE" Click="CloseAboutButton_Click" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Center" Padding="28,0" Background="#FFD9F2E5" BorderBrush="#FFA8D9BD"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
