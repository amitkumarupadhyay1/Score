<Window x:Class="Score.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Score"
        Title="QuizScore Live" Icon="star.png" WindowState="Maximized" WindowStartupLocation="CenterScreen" MinWidth="960" MinHeight="600"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF07101F" Offset="0"/><GradientStop Color="#FF111F36" Offset="0.48"/><GradientStop Color="#FF10172C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid x:Name="RootLayout" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,8" CornerRadius="18" Background="#DD111E33" BorderBrush="#FF243D60" BorderThickness="1" Effect="{StaticResource HeaderGlowEffect}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBox x:Name="EventTitleEditor" Text="QUIZ CHAMPIONSHIP" MaxLength="50" ToolTip="Event title" FontSize="21" FontWeight="Bold" Foreground="#FFF5F8FF" Background="Transparent" BorderThickness="0" Padding="0" KeyDown="EventTitleEditor_KeyDown" LostFocus="EventTitleEditor_LostFocus" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="LIVE CONTROL DESK" FontSize="10" FontWeight="Bold" Foreground="#FF80A6D4"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#FF4D6384"/>
                        <TextBlock x:Name="RoundNumberLabel" Text="ROUND 1" FontSize="10" FontWeight="Bold" Foreground="#FFF4C95D"/>
                        <TextBlock Text="  •  " FontSize="10" Foreground="#FF4D6384"/>
                        <TextBlock x:Name="CompetitionStatusLabel" Text="READY TO START" FontSize="10" FontWeight="Bold" Foreground="#FF82D7AF"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Padding="13,7" CornerRadius="14" Background="#FF182A45" BorderBrush="#FF2C4D74" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="TeamCountLabel" Text="4" FontSize="18" FontWeight="Bold" Foreground="#FFF4C95D"/><TextBlock Text=" TEAMS" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FFB3C8E8"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,8" Padding="12,8" CornerRadius="14" Background="#DD101D31" BorderBrush="#FF243D60" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="2.6*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="ROUND SETUP" FontSize="10" FontWeight="Bold" Foreground="#FFF4C95D" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="FORMAT" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RoundFormatSelector" Height="34" SelectedIndex="0" Style="{StaticResource ToolbarComboStyle}" SelectionChanged="RoundFormatSelector_SelectionChanged">
                                <ComboBoxItem Content="Standard"/><ComboBoxItem Content="Rapid fire"/><ComboBoxItem Content="Buzzer"/><ComboBoxItem Content="Visual / audio"/><ComboBoxItem Content="Tie-breaker"/><ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ROUND NAME" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <TextBox x:Name="RoundLabelEditor" Height="34" Text="General Knowledge" MaxLength="40" Style="{StaticResource ToolbarTextStyle}" ToolTip="Round name, category, or question set" LostFocus="RoundLabelEditor_LostFocus"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <TextBlock Text="TIME LIMITS" FontSize="10" FontWeight="Bold" Foreground="#FFF4C95D" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="WHOLE EVENT" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="GlobalMinutesSelector" Width="86" Height="34" SelectedIndex="0" Style="{StaticResource ToolbarComboStyle}" ToolTip="Maximum time for the whole quiz" SelectionChanged="TimerDurationSelector_SelectionChanged"><ComboBoxItem Content="No limit"/><ComboBoxItem Content="15 min"/><ComboBoxItem Content="30 min"/><ComboBoxItem Content="45 min"/><ComboBoxItem Content="60 min"/><ComboBoxItem Content="90 min"/><ComboBoxItem Content="120 min (2 hr)"/></ComboBox>
                                <TextBlock x:Name="GlobalTimerLabel" Text="NO LIMIT" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#FF82D7AF"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="EACH ROUND" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="RoundMinutesSelector" Width="86" Height="34" SelectedIndex="2" Style="{StaticResource ToolbarComboStyle}" ToolTip="Maximum time for each round" SelectionChanged="TimerDurationSelector_SelectionChanged"><ComboBoxItem Content="No limit"/><ComboBoxItem Content="1 min"/><ComboBoxItem Content="2 min"/><ComboBoxItem Content="3 min"/><ComboBoxItem Content="5 min"/><ComboBoxItem Content="10 min"/></ComboBox>
                                <TextBlock x:Name="RoundTimerLabel" Text="02:00" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#FF82D7AF"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="LIVE SESSION" FontSize="10" FontWeight="Bold" Foreground="#FFF4C95D" Margin="0,0,0,4"/>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="TEAMS" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TeamCountSelector" Width="64" Height="34" SelectedIndex="2" SelectionChanged="TeamCountSelector_SelectionChanged" Style="{StaticResource ToolbarComboStyle}" ToolTip="Number of teams playing" AutomationProperties.Name="Number of teams"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/></ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,4">
                            <TextBlock Text="TOTAL ROUNDS" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RoundCountSelector" Width="64" Height="34" SelectedIndex="2" SelectionChanged="RoundCountSelector_SelectionChanged" Style="{StaticResource ToolbarComboStyle}"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/><ComboBoxItem Content="8"/><ComboBoxItem Content="9"/><ComboBoxItem Content="10"/></ComboBox>
                        </StackPanel>
                        <Button x:Name="StartTimerButton" Margin="0,19,7,4" Content="START LIVE" Click="StartTimerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF27775A" BorderBrush="#FF66C99C"/>
                        <Button x:Name="PauseTimerButton" Margin="0,19,7,4" Content="PAUSE" Click="PauseTimerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF866029" BorderBrush="#FFD7A75E"/>
                        <Button x:Name="ResumeTimerButton" Margin="0,19,7,4" Content="RESUME" Click="ResumeTimerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF2166A4" BorderBrush="#FF5099DE"/>
                        <Button x:Name="RestartTimerButton" Margin="0,19,7,4" Content="RESTART TIMERS" Click="RestartTimerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF4B6385" BorderBrush="#FF8AA8D0" ToolTip="Reset the event and round clocks, then start them again"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="TeamCardsViewport" Grid.Row="2" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" CanContentScroll="False">
            <Grid x:Name="TeamCardsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="11,9" CornerRadius="14" Background="#DD101D31" BorderBrush="#FF243D60" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LIVE ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="#FF7189AD" Margin="0,0,9,0"/><TextBlock x:Name="EventFeedLabel" Text="Set the teams, add player names, then start the first round." FontSize="12" Foreground="#FFC0D0EA" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="UNDO LAST" Click="UndoLastScoreButton_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Reverse the latest score change and add an audit-log entry"/>
                    <Button Content="FINISH ROUND" Click="FinishRoundButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF27775A" BorderBrush="#FF66C99C"/>
                    <Button Content="ROUND RESULT" Click="AnnounceWinnerButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF6A4E9A" BorderBrush="#FFA888DC" ToolTip="Preview the current round ranking without finishing the round"/>
                    <Button Content="STANDINGS" Click="ShowStandingsButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF355B78" BorderBrush="#FF6FA9D1" ToolTip="View completed-round scores without stopping the current round"/>
                    <Button Content="EXPORT LOG" Click="ExportLogButton_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button Content="ABOUT" Click="AboutButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF355B78" BorderBrush="#FF6FA9D1" ToolTip="View application and developer information"/>
                    <Button Content="NEW GAME" Click="ResetButton_Click" Style="{StaticResource ToolbarButtonStyle}" Background="#FF542C3C" BorderBrush="#FF9A5269"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WinnerOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Background="#F2081120" Panel.ZIndex="10" CornerRadius="18">
            <Border HorizontalAlignment="Center" VerticalAlignment="Stretch" MaxWidth="1120" Margin="24" Padding="30,24" Background="#FF101D31" BorderBrush="#FF315278" BorderThickness="1" CornerRadius="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <TextBlock x:Name="WinnerContext" Text="ROUND COMPLETE" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FFF4C95D"/>
                    <TextBlock x:Name="WinnerTitle" Text="WINNER" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="42" FontWeight="Bold" Foreground="#FFF5F8FF" TextAlignment="Center"/>
                    <TextBlock x:Name="WinnerScore" HorizontalAlignment="Center" Margin="0,2,0,18" FontFamily="Impact" FontSize="52" Foreground="#FFF4C95D" TextAlignment="Center"/>
                    <Grid x:Name="RoundResultsPanel" MinWidth="760" Margin="0,0,0,18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="12,0,12,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD"/>
                            <TextBlock Grid.Column="1" Text="TEAM" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD"/>
                            <TextBlock Grid.Column="2" Text="ROUND SCORE" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="TOURNAMENT TOTAL" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="RESPONSE TIME" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="RoundResultsRows" Grid.Row="1"/>
                    </Grid>
                    <Grid x:Name="FinalStandings" MinWidth="860" Margin="0,0,0,20" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,0,14,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD"/>
                            <TextBlock Grid.Column="1" Text="TEAM" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD"/>
                            <TextBlock Grid.Column="2" Text="FINAL SCORE" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="SCORES / ROUND TIME" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TEAM TIME" FontSize="9" FontWeight="Bold" Foreground="#FF7189AD" TextAlignment="Right"/>
                        </Grid>
                        <StackPanel x:Name="FinalStandingsRows" Grid.Row="1"/>
                    </Grid>
                    <Button x:Name="WinnerActionButton" Content="NEXT ROUND" Click="WinnerActionButton_Click" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Center" Padding="24,0" Background="#FFF4C95D" Foreground="#FF211800" BorderBrush="#FFFFE79A"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border x:Name="AboutOverlay" Grid.Row="0" Grid.RowSpan="5" Visibility="Collapsed" Background="#F2081120" Panel.ZIndex="20" CornerRadius="18">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520" Padding="34" Background="#FF101D31" BorderBrush="#FF4F86B4" BorderThickness="1" CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="ABOUT THE APPLICATION" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#FFF4C95D"/>
                    <TextBlock Text="QuizScore Live" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="36" FontWeight="Bold" Foreground="#FFF5F8FF"/>
                    <TextBlock x:Name="AboutVersionLabel" HorizontalAlignment="Center" Margin="0,4,0,24" FontSize="13" Foreground="#FF8FB4D8"/>
                    <Border Padding="20" Background="#FF182A45" BorderBrush="#FF2C4D74" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="DESIGNED AND DEVELOPED BY" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="#FF7189AD"/>
                            <TextBlock Text="AMIT KUMAR UPADHYAY" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="22" FontWeight="Bold" Foreground="#FFF4C95D" TextAlignment="Center"/>
                            <TextBlock Text="School - JB Academy, Ayodhya" HorizontalAlignment="Center" Margin="0,7,0,0" FontSize="14" Foreground="#FFC0D0EA" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Live scoring, timing, standings, and audit-ready quiz records." HorizontalAlignment="Center" Margin="0,22,0,20" FontSize="12" Foreground="#FF9DB5D3" TextAlignment="Center"/>
                    <Button Content="CLOSE" Click="CloseAboutButton_Click" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Center" Padding="28,0" Background="#FF27775A" BorderBrush="#FF66C99C"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
