<Window x:Class="Score.QuizDeckBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Authoring Studio · QuizScore Live"
        MinWidth="920" MinHeight="520"
        Width="1280" Height="740"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF4F6F8" Offset="0"/><GradientStop Color="#FFEFF2F5" Offset="0.48"/><GradientStop Color="#FFF4F6F8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Modern Card Surface -->
        <Style x:Key="StudioCard" TargetType="Border"><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFE2E8F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <!-- Section Card Header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FF64748B"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
        <!-- Modern Input Label -->
        <Style x:Key="InputLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FF475569"/><Setter Property="Margin" Value="0,0,0,6"/></Style>

        <!-- Modern Text Box -->
        <Style x:Key="ModernTextBox" TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#FF0F172A"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFCBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#FF94A3B8"/></Trigger>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="#FF005A9C"/><Setter TargetName="border" Property="BorderThickness" Value="1.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Multi-line Text Box -->
        <Style x:Key="ModernMultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"><Setter Property="Height" Value="75"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/></Style>

        <!-- Modern ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboStyle}"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#FF0F172A"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFCBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>

        <!-- Primary Action Button (Corporate Blue) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource BroadcastPrimaryButtonStyle}"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,0"/><Setter Property="FontSize" Value="12"/></Style>

        <!-- Secondary Outline Button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BroadcastNeutralButtonStyle}"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="11"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top App Bar: Floating Luminous Broadcast Bar -->
        <Border Grid.Row="0" Margin="12,10,12,6" Padding="14,8" CornerRadius="16" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1" Effect="{StaticResource HeaderGlowEffect}">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Left: Studio Identity & Deck Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,14,3">
                    <Border Background="#FF005A9C" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="Q" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="QUIZ MAKER" FontSize="14" FontWeight="Bold" Foreground="#FF0F172A" />
                        <TextBlock Text="Authoring Studio" FontSize="10" FontWeight="Bold" Foreground="#FF64748B" />
                    </StackPanel>

                    <!-- Deck Dropdown -->
                    <Border Background="#FFF1F4F7" CornerRadius="8" Padding="8,2" Margin="0,0,8,0" BorderBrush="#FFCBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Deck:" FontSize="11" FontWeight="Bold" Foreground="#FF475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="DeckSelector" Width="170" Height="28" DisplayMemberPath="Title" SelectedValuePath="QuizDeckId" SelectionChanged="DeckSelector_SelectionChanged" Style="{StaticResource ToolbarComboStyle}" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- Deck Title Editor -->
                    <TextBox x:Name="DeckTitleEditor" Width="180" Height="32" FontSize="13" FontWeight="SemiBold" Background="#FFFFFFFF" Foreground="#FF0F172A" BorderBrush="#FFCBD5E1" BorderThickness="1" Style="{StaticResource ToolbarTextStyle}" VerticalContentAlignment="Center" Padding="8,0" ToolTip="Edit deck title" />
                </StackPanel>

                <!-- Right: Deck & Exchange Controls -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                    <TextBlock Text="Theme:" FontSize="11" FontWeight="Bold" Foreground="#FF475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="DeckThemeSelector" Width="110" Height="32" Margin="0,0,8,0" Style="{StaticResource ToolbarComboStyle}" SelectionChanged="DeckThemeSelector_SelectionChanged" />
                    <Button x:Name="SaveDeckButton" Content="Save Deck" Style="{StaticResource BroadcastSuccessButtonStyle}" Margin="0,0,6,0" Click="SaveDeckButton_Click" />
                    <Button x:Name="NewDeckButton" Content="+ New Deck" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="NewDeckButton_Click" />
                    <Button x:Name="DeleteDeckButton" Content="Delete Deck" Style="{StaticResource BroadcastDangerButtonStyle}" Margin="0,0,6,0" Click="DeleteDeckButton_Click" ToolTip="Permanently delete the active quiz deck" />
                    <Button x:Name="LoadSampleDeckButton" Content="Load Sample" Style="{StaticResource BroadcastBlueTintButtonStyle}" Margin="0,0,8,0" Click="LoadSampleDeckButton_Click" ToolTip="Load showcase sample quiz into studio" />

                    <Button x:Name="QuickAiQuizButton" Content="Quick AI / Topic Quiz" Style="{StaticResource BroadcastPrimaryButtonStyle}" Margin="0,0,6,0" Click="QuickAiQuizButton_Click" ToolTip="Instantly generate a 5-question trivia round from curated topics" />
                    <Button x:Name="SmartPasteButton" Content="Smart AI Paste" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,8,0" Click="SmartPasteButton_Click" ToolTip="Paste questions copied from ChatGPT, Claude, Gemini or documents" />

                    <Border Width="1" Height="20" Background="#FFCBD5E1" Margin="2,0,8,0" VerticalAlignment="Center" />

                    <Button x:Name="ImportCsvButton" Content="Import CSV" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="ImportCsvButton_Click" ToolTip="Import question batch from Excel / CSV" />
                    <Button x:Name="ExportCsvButton" Content="Export CSV" Style="{StaticResource BroadcastNeutralButtonStyle}" Margin="0,0,6,0" Click="ExportCsvButton_Click" ToolTip="Export current deck to CSV" />
                    <Button x:Name="TemplateButton" Content="Template" Style="{StaticResource BroadcastNeutralButtonStyle}" Click="TemplateButton_Click" ToolTip="Save sample Excel/CSV template" />
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- Main Body: 3-Column Studio -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="280" MinWidth="0" />
                <ColumnDefinition x:Name="CenterColumnDef" Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="RightColumnDef" Width="320" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Left Slide Deck Explorer -->
            <Border Grid.Column="0" Background="#FFFFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Top Action Bar -->
                    <Border DockPanel.Dock="Top" Background="#F8FFFFFF" Padding="14,10" BorderBrush="#FFD6DEE8" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="QUESTIONS" FontSize="11" FontWeight="Bold" Foreground="#FF172B4D" />
                                <TextBlock x:Name="SlideCountLabel" Text="0 questions" FontSize="10" FontWeight="SemiBold" Foreground="#FF64748B" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button x:Name="AddSlideButton" Grid.Column="1" Content="+ Add" Style="{StaticResource BroadcastSuccessButtonStyle}" Height="28" Padding="10,0" Margin="4,0,0,0" Click="AddSlideButton_Click" ToolTip="Add a new question" />
                            <Button x:Name="DuplicateSlideButton" Grid.Column="2" Content="Duplicate" Style="{StaticResource BroadcastNeutralButtonStyle}" Height="28" Padding="10,0" Margin="4,0,0,0" Click="DuplicateSlideButton_Click" ToolTip="Duplicate selected slide" />
                            <Button x:Name="CollapseLeftPanelButton" Grid.Column="3" Content="&lt;" Style="{StaticResource BroadcastNeutralButtonStyle}" Height="28" Width="28" Padding="0" Margin="4,0,0,0" Click="CollapseLeftPanelButton_Click" ToolTip="Collapse questions panel" />
                        </Grid>
                    </Border>

                    <!-- Bottom Reorder & Delete Bar -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FFFFFF" Padding="10,8" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MoveUpButton" Grid.Column="0" Content="Up" Style="{StaticResource BroadcastNeutralButtonStyle}" Height="28" Margin="0,0,4,0" Padding="8,0" Click="MoveUpButton_Click" IsEnabled="False" />
                            <Button x:Name="MoveDownButton" Grid.Column="1" Content="Down" Style="{StaticResource BroadcastNeutralButtonStyle}" Height="28" Margin="0,0,4,0" Padding="8,0" Click="MoveDownButton_Click" IsEnabled="False" />
                            <Button x:Name="DeleteSlideButton" Grid.Column="2" Content="Delete" Style="{StaticResource BroadcastDangerButtonStyle}" Height="28" Padding="8,0" Click="DeleteSlideButton_Click" IsEnabled="False" />
                        </Grid>
                    </Border>

                    <!-- Slide Cards List Container -->
                    <Grid>
                        <!-- Empty State Card -->
                        <Border x:Name="EmptySlideListCard" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="14" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No Questions Yet" FontSize="13" FontWeight="Bold" Foreground="#FF172B4D" HorizontalAlignment="Center" />
                                <TextBlock Text="Add your first question to begin authoring this quiz." FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12" />
                                <Button Content="+ Add Question" Style="{StaticResource BroadcastSuccessButtonStyle}" Height="30" HorizontalAlignment="Center" Click="AddSlideButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- Slide Cards List -->
                        <ListBox x:Name="SlideListBox" BorderThickness="0" Background="#FFFFFFFF" SelectionChanged="SlideListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="6,4,6,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="cardBorder" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="#FFF1F5F9"/>
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FFCBD5E1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="cardBorder" Property="Background" Value="#FFEFF6FF"/>
                                                        <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FF005A9C"/>
                                                        <Setter TargetName="cardBorder" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Question Number Pill -->
                                        <Border Grid.Column="0" Background="#FFE2E8F0" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SlideOrder}" FontSize="10" FontWeight="Bold" Foreground="#FF475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <WrapPanel Margin="0,0,0,3">
                                                <Border Background="#FFE0F2FE" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding RoundName, FallbackValue='General'}" FontSize="9" FontWeight="Bold" Foreground="#FF0369A1" />
                                                </Border>
                                                <!-- Dynamic Slide Type Badge -->
                                                <Border Background="{Binding SlideTypeBadgeBg}" CornerRadius="4" Padding="5,1">
                                                    <TextBlock Text="{Binding SlideTypeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SlideTypeBadgeFg}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FF0F172A" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Points Badge -->
                                        <TextBlock Grid.Column="2" Text="{Binding PointsBadgeText}" Visibility="{Binding PointsBadgeVisibility}" FontSize="11" FontWeight="Bold" Foreground="#FF005A9C" VerticalAlignment="Top" Margin="6,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Column 2: Center Question Authoring Canvas -->
            <Border Grid.Column="1" Background="#FFF8FAFC">
                <DockPanel>
                    <!-- Expand Toggles when Panels are Collapsed -->
                    <DockPanel DockPanel.Dock="Top" Margin="16,6,16,0">
                        <Button x:Name="ExpandLeftPanelButton" Content="&gt; QUESTIONS" Visibility="Collapsed" Style="{StaticResource BroadcastBlueTintButtonStyle}" Height="26" Padding="10,0" FontSize="10" Click="ExpandLeftPanelButton_Click" ToolTip="Show question list panel" DockPanel.Dock="Left" />
                        <Button x:Name="ExpandRightPanelButton" Content="&lt; SIMULATOR" Visibility="Collapsed" Style="{StaticResource BroadcastBlueTintButtonStyle}" Height="26" Padding="10,0" FontSize="10" Click="ExpandRightPanelButton_Click" ToolTip="Show stage screen simulator" DockPanel.Dock="Right" />
                    </DockPanel>

                    <!-- Bottom Fixed Save Action Bar -->
                    <Border DockPanel.Dock="Bottom" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0" Padding="24,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="EditStatusIndicator" Text="Editing Slide" FontSize="12" FontWeight="SemiBold" Foreground="#FF64748B" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="SaveSlideButton" Content="Save Question" Style="{StaticResource BroadcastPrimaryButtonStyle}" Height="36" Width="160" Click="SaveSlideButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Question Form Cards -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20">
                        <StackPanel x:Name="SlideEditorPanel">

                            <!-- Deck Locked by Active Session Banner -->
                            <Border x:Name="DeckLockedBanner" Background="#FFFFFBEB" BorderBrush="#FFFDE68A" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="Deck Locked by Active Quiz Session" FontSize="12" FontWeight="Bold" Foreground="#FF92400E" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DeckLockedText" Text="This deck is linked to an active quiz session. Finish the session to enable editing and adding questions." FontSize="11.5" Foreground="#FFB45309" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="UnlockDeckButton" Grid.Column="1" Content="End Session &amp; Unlock" Style="{StaticResource BroadcastWarningButtonStyle}" Height="30" Padding="12,0" Margin="10,0,0,0" VerticalAlignment="Center" Click="UnlockDeckButton_Click" ToolTip="End the active quiz session so you can edit and add questions to this deck" />
                                </Grid>
                            </Border>

                            <!-- Validation Alert Banner -->
                            <Border x:Name="ValidationAlertBanner" Background="#FFFEF2F2" BorderBrush="#FFFCA5A5" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Please resolve the following before saving:" FontSize="12" FontWeight="Bold" Foreground="#FF991B1B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="ValidationAlertText" FontSize="11.5" Foreground="#FFB91C1C" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                    <Button x:Name="DismissAlertButton" Grid.Column="1" Content="X" Width="26" Height="26" Background="Transparent" BorderThickness="0" Foreground="#FF991B1B" FontWeight="Bold" FontSize="12" Cursor="Hand" VerticalAlignment="Top" Click="DismissAlertButton_Click" ToolTip="Dismiss alert" />
                                </Grid>
                            </Border>

                            <!-- Instruction Notice Banner -->
                            <Border x:Name="InstructionNoticeBanner" Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="Announcement &amp; Rules Slide" FontSize="12" FontWeight="Bold" Foreground="#FF1E40AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="This slide is for announcements, round rules, or intermission notices. Options, scoring rules, and answer keys are not required." FontSize="11.5" Foreground="#FF1D4ED8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Card: Structured Stage Rules (Instruction slides) -->
                            <Border x:Name="CardStageRules" Style="{StaticResource StudioCard}" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="StageRuleInheritButton" DockPanel.Dock="Right" Content="Inherit from Round" Style="{StaticResource BroadcastBlueTintButtonStyle}" Height="24" Padding="8,0" Click="StageRuleInheritButton_Click" ToolTip="Pull parent round default scoring and rules into this stage rules card" />
                                        <TextBlock Text="STAGE RULES CARD (STAGE DISPLAY)" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" Margin="0" />
                                    </DockPanel>
                                    <CheckBox x:Name="StageRulesEnabledCheckBox" Content="Enable Structured Rules Card on Stage Screen" FontWeight="SemiBold" FontSize="12" Foreground="#FF334155" Margin="0,0,0,8" Checked="StageRulesEnabled_Changed" Unchecked="StageRulesEnabled_Changed" />
                                    <Grid x:Name="StageRulesFieldsGrid" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Mode Badge" Style="{StaticResource InputLabel}" />
                                            <ComboBox x:Name="StageRuleModeSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="PreviewSelector_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Text="Correct Pts" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="StageRulePointsEditor" Style="{StaticResource ModernTextBox}" Text="10" TextAlignment="Center" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Text="Bounce Pts" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="StageRuleBounceEditor" Style="{StaticResource ModernTextBox}" Text="5" TextAlignment="Center" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Text="Penalty" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="StageRulePenaltyEditor" Style="{StaticResource ModernTextBox}" Text="0" TextAlignment="Center" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Time (sec)" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="StageRuleTimeEditor" Style="{StaticResource ModernTextBox}" Text="15" TextAlignment="Center" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox x:Name="StageRuleConferringCheckBox" Content="Conferring Allowed" IsChecked="True" FontSize="11.5" Foreground="#FF334155" Margin="0,0,16,0" Checked="StageRulesCheck_Changed" Unchecked="StageRulesCheck_Changed" />
                                        <CheckBox x:Name="StageRuleInfiniteBounceCheckBox" Content="Infinite Bounce" IsChecked="True" FontSize="11.5" Foreground="#FF334155" Checked="StageRulesCheck_Changed" Unchecked="StageRulesCheck_Changed" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card 1: Question Essentials -->
                            <Border x:Name="Card1QuestionEssentials" Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock x:Name="Card1Header" Text="1. QUESTION ESSENTIALS" Style="{StaticResource SectionHeader}" />

                                    <!-- Quick Format Bar: 4 Columns -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <DockPanel Margin="0,0,0,3">
                                                <Button x:Name="ManageRoundsButton" DockPanel.Dock="Right" Content="Rounds" Style="{StaticResource SecondaryButton}" Height="18" Padding="5,0" FontSize="10" Click="ManageRoundsButton_Click" ToolTip="Add, edit, or configure rounds for this deck" />
                                                <TextBlock Text="Quiz Round" Style="{StaticResource InputLabel}" Margin="0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ComboBox x:Name="SlideRoundSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="SlideRoundSelector_SelectionChanged" DisplayMemberPath="RoundTitle" SelectedValuePath="QuizRoundId" />
                                            <TextBox x:Name="SlideRoundNameEditor" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Slide Type" Style="{StaticResource InputLabel}" />
                                            <ComboBox x:Name="SlideTypeSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="SlideTypeSelector_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Question Format" Style="{StaticResource InputLabel}" />
                                            <ComboBox x:Name="QuestionTypeSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="QuestionTypeSelector_SelectionChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Conducting Mode" Style="{StaticResource InputLabel}" />
                                            <ComboBox x:Name="RoundTypeSelector" Style="{StaticResource ModernComboBox}" SelectionChanged="PreviewSelector_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Question Title -->
                                    <TextBlock x:Name="SlideTitleLabel" Text="Question Title / Headline" Style="{StaticResource InputLabel}" />
                                    <TextBox x:Name="SlideTitleEditor" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" TextChanged="PreviewEditor_TextChanged" />

                                    <!-- Question Prompt -->
                                    <TextBlock x:Name="SlideContentLabel" Text="Question Prompt (Displayed to players &amp; audience)" Style="{StaticResource InputLabel}" />
                                    <TextBox x:Name="SlideContentEditor" Style="{StaticResource ModernMultiLineTextBox}" Height="85" FontSize="14" TextChanged="PreviewEditor_TextChanged" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Interactive Options & Answer Keys -->
                            <Border x:Name="Card2AnswerKeys" Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="2. ANSWER KEYS &amp; CHOICES" Style="{StaticResource SectionHeader}" />

                                    <!-- Context-Sensitive Panel 2A: Multiple Choice Options -->
                                    <StackPanel x:Name="McqOptionsContainer" Margin="0,0,0,8">
                                        <TextBlock Text="Choice Options (Type options below and select the radio button for the correct answer)" FontSize="11" Foreground="#FF64748B" Margin="0,0,0,10" />

                                        <!-- Option A -->
                                        <Border x:Name="OptionACard" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" Cursor="Hand" PreviewMouseLeftButtonDown="OptionCard_PreviewMouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Background="#FFE2E8F0" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Center"><TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="#FF334155" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <TextBox x:Name="OptionAEditor" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" TextChanged="OptionEditor_TextChanged" />
                                                <RadioButton x:Name="OptionACheck" Grid.Column="2" GroupName="McqAnswerChoice" Content="Correct Answer" FontSize="11" FontWeight="SemiBold" Foreground="#FF15803D" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OptionCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Option B -->
                                        <Border x:Name="OptionBCard" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" Cursor="Hand" PreviewMouseLeftButtonDown="OptionCard_PreviewMouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Background="#FFE2E8F0" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Center"><TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="#FF334155" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <TextBox x:Name="OptionBEditor" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" TextChanged="OptionEditor_TextChanged" />
                                                <RadioButton x:Name="OptionBCheck" Grid.Column="2" GroupName="McqAnswerChoice" Content="Correct Answer" FontSize="11" FontWeight="SemiBold" Foreground="#FF15803D" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OptionCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Option C -->
                                        <Border x:Name="OptionCCard" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6" Cursor="Hand" PreviewMouseLeftButtonDown="OptionCard_PreviewMouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Background="#FFE2E8F0" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Center"><TextBlock Text="C" FontSize="11" FontWeight="Bold" Foreground="#FF334155" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <TextBox x:Name="OptionCEditor" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" TextChanged="OptionEditor_TextChanged" />
                                                <RadioButton x:Name="OptionCCheck" Grid.Column="2" GroupName="McqAnswerChoice" Content="Correct Answer" FontSize="11" FontWeight="SemiBold" Foreground="#FF15803D" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OptionCheck_Changed" />
                                            </Grid>
                                        </Border>

                                        <!-- Option D -->
                                        <Border x:Name="OptionDCard" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8" Cursor="Hand" PreviewMouseLeftButtonDown="OptionCard_PreviewMouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Background="#FFE2E8F0" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Center"><TextBlock Text="D" FontSize="11" FontWeight="Bold" Foreground="#FF334155" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <TextBox x:Name="OptionDEditor" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" Padding="8,0" VerticalContentAlignment="Center" TextChanged="OptionEditor_TextChanged" />
                                                <RadioButton x:Name="OptionDCheck" Grid.Column="2" GroupName="McqAnswerChoice" Content="Correct Answer" FontSize="11" FontWeight="SemiBold" Foreground="#FF15803D" VerticalAlignment="Center" Margin="8,0,0,0" Checked="OptionCheck_Changed" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Context-Sensitive Panel 2B: True / False Toggle -->
                                    <StackPanel x:Name="TrueFalseContainer" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock Text="Select the correct answer key:" FontSize="11" Foreground="#FF64748B" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="TrueChoiceButton" Grid.Column="0" Content="TRUE" Height="42" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" FontSize="14" FontWeight="Bold" Click="TrueChoiceButton_Click" />
                                            <Button x:Name="FalseChoiceButton" Grid.Column="1" Content="FALSE" Height="42" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" FontSize="14" FontWeight="Bold" Click="FalseChoiceButton_Click" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Context-Sensitive Panel 2C: Manual Notice -->
                                    <Border x:Name="ManualNoticeContainer" Background="#FFF1F5F9" BorderBrush="#FFCBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="Live Discretionary Adjudication" FontSize="12" FontWeight="Bold" Foreground="#FF334155" />
                                            <TextBlock Text="This question will be scored manually by the quizmaster during the live quiz." FontSize="11" Foreground="#FF64748B" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Primary Answer & Aliases (Always visible for verification & Short Answer) -->
                                    <Grid Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Primary Correct Answer" Style="{StaticResource InputLabel}" Foreground="#FF15803D" />
                                            <TextBox x:Name="SlideCorrectAnswerEditor" Style="{StaticResource ModernTextBox}" FontWeight="Bold" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Accepted Synonyms / Aliases (Separate by semicolon)" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideAlternateAnswersEditor" Style="{StaticResource ModernTextBox}" ToolTip="e.g. Gandhi; M.K. Gandhi; Mohandas Gandhi" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Adjudication Directives (Prompt On & Do Not Accept) -->
                                    <Grid x:Name="DirectivesContainer" Margin="0,4,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Prompt On Directive (Ask player to specify)" Style="{StaticResource InputLabel}" Foreground="#FFB45309" />
                                            <TextBox x:Name="SlidePromptOnEditor" Style="{StaticResource ModernTextBox}" ToolTip="Directive for host teleprompter: ask player for more detail (e.g. Prompt on 'Roosevelt' for first name)" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Do Not Accept Directive (Reject near-misses)" Style="{StaticResource InputLabel}" Foreground="#FFB91C1C" />
                                            <TextBox x:Name="SlideDoNotAcceptEditor" Style="{StaticResource ModernTextBox}" ToolTip="Explicit rejection warning on host teleprompter (e.g. Do not accept 'England' for 'United Kingdom')" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Bulk Raw Options (Collapsed by default, available for power users) -->
                                    <Expander Header="Bulk / Raw Options List" FontSize="11" Foreground="#FF64748B" Margin="0,4,0,0">
                                        <StackPanel x:Name="OptionsContainer" Margin="0,6,0,0">
                                            <TextBlock Text="One option per line (e.g. Paris \n London \n Tokyo \n Rome)" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideOptionsEditor" Style="{StaticResource ModernMultiLineTextBox}" Height="75" TextChanged="SlideOptionsEditor_TextChanged" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Scoring & Turn Rules -->
                            <Border x:Name="Card3ScoringRules" Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="3. SCORING &amp; TURN RULES" Style="{StaticResource SectionHeader}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Correct Points" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlidePointsEditor" Style="{StaticResource ModernTextBox}" Text="10" TextAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Wrong Penalty" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlidePenaltyEditor" Style="{StaticResource ModernTextBox}" Text="0" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <TextBlock Text="Pass Bonus" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideBonusEditor" Style="{StaticResource ModernTextBox}" Text="5" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,14,0">
                                            <TextBlock Text="Time (sec)" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideTimeLimitEditor" Style="{StaticResource ModernTextBox}" Text="30" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,12,0,0">
                                            <CheckBox x:Name="SlideAllowPassCheckBox" Content="Allow Bounce / Pass" IsChecked="True" FontWeight="SemiBold" FontSize="12" Foreground="#FF334155" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Clues, Host Trivia & Media -->
                            <Border x:Name="Card4MediaClues" Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="4. CLUES, HOST TRIVIA &amp; MEDIA" Style="{StaticResource SectionHeader}" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Progressive Clues (One clue per line)" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideHintsEditor" Style="{StaticResource ModernMultiLineTextBox}" Height="70" ToolTip="Clues revealed step-by-step during buzzer or bounce rounds" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Secret Host Notes / Trivia / Explanation" Style="{StaticResource InputLabel}" />
                                            <TextBox x:Name="SlideExplanationEditor" Style="{StaticResource ModernMultiLineTextBox}" Height="70" ToolTip="Host background context and trivia revealed on answer" TextChanged="PreviewEditor_TextChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Clue Point Decay -->
                                    <StackPanel x:Name="ClueDecayContainer" Margin="0,0,0,10">
                                        <TextBlock Text="Clue Score Decay (Step-down point values, comma-separated)" Style="{StaticResource InputLabel}" />
                                        <TextBox x:Name="SlideClueDecayEditor" Style="{StaticResource ModernTextBox}" ToolTip="Comma-separated point values for progressive clues (e.g. 50, 40, 30, 20, 10)" TextChanged="PreviewEditor_TextChanged" />
                                    </StackPanel>

                                    <!-- Media Attachment -->
                                    <TextBlock Text="Media Attachment (Image, Video, or Audio clue)" Style="{StaticResource InputLabel}" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SlideMediaPathEditor" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" TextChanged="PreviewEditor_TextChanged" />
                                        <Button x:Name="BrowseMediaButton" Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BrowseMediaButton_Click" />
                                        <ComboBox x:Name="MediaDisplayModeSelector" Grid.Column="2" Style="{StaticResource ModernComboBox}" />
                                    </Grid>

                                    <!-- Hidden / Compact Slide Index -->
                                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                        <TextBox x:Name="SlideOrderEditor" Style="{StaticResource ModernTextBox}" Width="50" Height="30" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Column 3: Live Stage & Projector Simulator -->
            <Border Grid.Column="2" Background="#FFF1F5F9" BorderBrush="#FFD6DEE8" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="#F8FFFFFF" Padding="14,10" BorderBrush="#FFD6DEE8" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="STAGE SCREEN SIMULATOR" FontSize="11" FontWeight="Bold" Foreground="#FF172B4D" />
                                <TextBlock Text="Live preview of what audience &amp; teams will see" FontSize="10" FontWeight="SemiBold" Foreground="#FF64748B" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="CollapseRightPanelButton" Grid.Column="1" Content="&gt;" Style="{StaticResource BroadcastNeutralButtonStyle}" Height="28" Width="28" Padding="0" Margin="4,0,0,0" Click="CollapseRightPanelButton_Click" ToolTip="Collapse simulator panel" />
                        </Grid>
                    </Border>

                    <!-- Preview Frame: Dark Stage Theme (#0A0F1D) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <Border x:Name="PreviewStageScreenBorder" Background="#FF0A0F1D" BorderBrush="#FF1E293B" BorderThickness="1" CornerRadius="12" Padding="16" MinHeight="260">
                                <Grid x:Name="PreviewPanel">
                                    <TextBlock Text="Select or create a slide to preview" Foreground="#FF64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Host Teleprompter Card (Below Stage Screen) -->
                            <Border Background="#FFFFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0">
                                <StackPanel x:Name="HostTeleprompterPanel">
                                    <TextBlock Text="QUIZMASTER TELEPROMPTER" FontSize="10" FontWeight="Bold" Foreground="#FF172B4D" Margin="0,0,0,8" />
                                    <TextBlock x:Name="HostAnswerKeyLabel" Text="Answer: -" FontSize="13" FontWeight="Bold" Foreground="#FF15803D" Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HostAliasesLabel" Text="Aliases: None" FontSize="11" Foreground="#FF64748B" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <TextBlock x:Name="HostNotesLabel" Text="No secret trivia notes." FontSize="11" FontStyle="Italic" Foreground="#FF334155" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F8FFFFFF" BorderBrush="#FFD6DEE8" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#FF475569" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>