<Application x:Class="Score.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <DropShadowEffect x:Key="PanelGlowEffect" Color="#FF54B5FF" BlurRadius="26" ShadowDepth="0" Opacity="0.16"/>
        <DropShadowEffect x:Key="HeaderGlowEffect" Color="#FF2A76B8" BlurRadius="30" ShadowDepth="0" Opacity="0.28"/>
        <Style x:Key="TeamNameEditorStyle" TargetType="TextBox"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFF6F9FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFB8D9FF" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/></Setter.Value></Setter></Style>
        <Style x:Key="PlayerEditorStyle" TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFF0F6FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF9CCBFF" BlurRadius="9" ShadowDepth="0" Opacity="0.65"/></Setter.Value></Setter></Style>
        <Style x:Key="ScoreLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="230"/><Setter Property="FontFamily" Value="Impact"/><Setter Property="Foreground" Value="#FFF5F8FF"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF000814" BlurRadius="13" ShadowDepth="7" Direction="315" Opacity="0.85"/></Setter.Value></Setter></Style>
        <Style x:Key="ScoreButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FFF5FAFF"/><Setter Property="Background" Value="#FF203451"/><Setter Property="BorderBrush" Value="#FF3D638E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#FF2C4D74"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#FFFFE79A"/><Setter TargetName="surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ScorePenaltyButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="Background" Value="#FF542C3C"/><Setter Property="BorderBrush" Value="#FF9A5269"/></Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="MinWidth" Value="86"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="10"/><Setter Property="Background" Value="#FF2166A4"/><Setter Property="BorderBrush" Value="#FF5099DE"/></Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="ToolbarComboStyle" TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FF172740"/><Setter Property="BorderBrush" Value="#FF365675"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FF172740"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FFB9E3F7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FFE8EDF3"/></Trigger></Style.Triggers></Style></Setter.Value></Setter><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF172740"/><Setter Property="Background" Value="#FFE8EDF3"/></Trigger></Style.Triggers></Style>
        <Style x:Key="ToolbarTextStyle" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="Foreground" Value="#FFF4F8FF"/><Setter Property="Background" Value="#FF172740"/><Setter Property="BorderBrush" Value="#FF365675"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Application.Resources>
</Application>
