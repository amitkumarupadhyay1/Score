<Application x:Class="Score.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <DropShadowEffect x:Key="PanelGlowEffect" Color="#FF7893AE" BlurRadius="18" ShadowDepth="0" Opacity="0.12"/>
        <DropShadowEffect x:Key="HeaderGlowEffect" Color="#FF7893AE" BlurRadius="22" ShadowDepth="0" Opacity="0.14"/>
        <Style x:Key="TeamNameEditorStyle" TargetType="TextBox"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="PlayerEditorStyle" TargetType="TextBox"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FF334155"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="ScoreLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="230"/><Setter Property="FontFamily" Value="Impact"/><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF081426" BlurRadius="1" ShadowDepth="0" Opacity="1"/></Setter.Value></Setter></Style>
        <Style x:Key="ScoreButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="48"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFE8EEF5"/><Setter Property="BorderBrush" Value="#FFB8C6D6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#FFD7E3EF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="surface" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="surface" Property="BorderBrush" Value="#FF2563A6"/><Setter TargetName="surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="surface" Property="Background" Value="#FFE8EDF3"/><Setter TargetName="surface" Property="BorderBrush" Value="#FFCBD5E1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ScorePenaltyButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="Background" Value="#FFFBE4E6"/><Setter Property="BorderBrush" Value="#FFE5AEB4"/></Style>
        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="MinWidth" Value="86"/><Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="10"/><Setter Property="Background" Value="#FFDCEBFA"/><Setter Property="BorderBrush" Value="#FFA8C5E3"/></Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ScoreButtonStyle}"><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="ToolbarComboStyle" TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="7,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFB8C6D6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Padding" Value="7,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFDCEBFA"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFE8F1FA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF475569"/><Setter Property="Background" Value="#FFE8EDF3"/></Trigger></Style.Triggers></Style></Setter.Value></Setter><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF475569"/><Setter Property="Background" Value="#FFE8EDF3"/></Trigger></Style.Triggers></Style>
        <Style x:Key="DarkToolbarComboStyle" TargetType="ComboBox"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#FF0F172A"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFCBD5E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FF0F172A"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFFFFFFF"/><Setter Property="Background" Value="#FF005A9C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsHighlighted" Value="True"><Setter Property="Foreground" Value="#FF005A9C"/><Setter Property="Background" Value="#FFDCEBFA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#FF94A3B8"/><Setter Property="Background" Value="#FFF1F5F9"/></Trigger></Style.Triggers></Style></Setter.Value></Setter></Style>
        <Style x:Key="ToolbarTextStyle" TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,0"/><Setter Property="Foreground" Value="#FF172B4D"/><Setter Property="Background" Value="#FFFFFFFF"/><Setter Property="BorderBrush" Value="#FFB8C6D6"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Application.Resources>
</Application>
