<Window x:Class="Score.QuizSmartPasteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart AI Paste Importer"
        Width="740" Height="580"
        MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Background" Value="#FF4F46E5"/>
            <Setter Property="BorderBrush" Value="#FF4338CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF6366F1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFCBD5E1"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFCBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#FF0F172A" Padding="20,14" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FF059669" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                        <TextBlock Text="📋" FontSize="13" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SMART AI PASTE IMPORTER" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Paste questions copied from ChatGPT, Claude, Gemini, or documents. The engine automatically extracts question prompts, choices, answer keys, clues, and trivia." FontSize="11" Foreground="#FF94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Text Input Area -->
        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="PASTE RAW QUESTIONS TEXT BELOW:" FontSize="10.5" FontWeight="Bold" Foreground="#FF64748B" Margin="0,0,0,6"/>
                <TextBox Grid.Row="1" x:Name="PasteInputBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12.5" FontFamily="Segoe UI" Padding="8,6" Background="#FFF8FAFC" BorderBrush="#FFCBD5E1" BorderThickness="1"/>
            </Grid>
        </Border>

        <!-- Action / Parse Bar -->
        <Border Grid.Row="2" Background="#FFF1F5F9" Padding="16,8" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ParseButton" Content="⚡ Parse &amp; Preview Questions" Style="{StaticResource ActionButton}" Height="30" Padding="14,0" Click="ParseButton_Click"/>
                <TextBlock Grid.Column="1" x:Name="ParseStatusLabel" Text="Paste questions above and click 'Parse &amp; Preview Questions'." FontSize="11" Foreground="#FF64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button Grid.Column="2" Content="Clear" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,0" Click="ClearButton_Click"/>
            </Grid>
        </Border>

        <!-- Parsed Questions Preview List -->
        <Border Grid.Row="3" Background="#FFF8FAFC" Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PARSED QUESTIONS PREVIEW:" FontSize="10.5" FontWeight="Bold" Foreground="#FF64748B" Margin="0,0,0,6"/>
                <ListBox x:Name="ParsedQuestionsListBox" BorderThickness="1" BorderBrush="#FFE2E8F0" Background="#FFFFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,4,4,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,4">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FFE2E8F0" CornerRadius="4" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SlideOrder}" FontSize="10" FontWeight="Bold" Foreground="#FF475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <WrapPanel Margin="0,0,0,2">
                                        <Border Background="{Binding SlideTypeBadgeBg}" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SlideTypeBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding SlideTypeBadgeFg}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#FF0F172A"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ContentText}" FontSize="11.5" Foreground="#FF334155" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding CorrectAnswer, StringFormat='Key: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#FF15803D"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ReplaceExistingCheckBox" Content="Replace existing slides in deck" FontSize="11" Foreground="#FF475569" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="34" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="ImportButton" Content="✓ Import Questions into Deck" Style="{StaticResource ActionButton}" Height="34" Padding="16,0" Click="ImportButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
