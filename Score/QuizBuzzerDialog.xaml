<Window x:Class="Score.QuizBuzzerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mobile Phone Buzzers · Local Wi-Fi"
        Width="640" Height="620"
        MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF0F172A" Padding="20,14" BorderBrush="#FF1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF4F46E5" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="📱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MOBILE CONTESTANT BUZZERS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Contestants join on the local Wi-Fi network and buzz directly from their phones." FontSize="11" Foreground="#FF94A3B8" Margin="36,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#FF065F46" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="● " Foreground="#FF34D399" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="SERVER ACTIVE" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel HorizontalAlignment="Center" Width="480">
                
                <!-- QR Code Card -->
                <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SCAN WITH PHONE CAMERA TO JOIN" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        
                        <Border BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Background="#FFFFFFFF" Padding="12" HorizontalAlignment="Center">
                            <Image x:Name="QrCodeImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>

                        <TextBlock Text="Point phone camera at the screen · No app download required" FontSize="11" Foreground="#FF64748B" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- URL Card -->
                <Border Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="LOCAL WI-FI URL" FontSize="11" FontWeight="Bold" Foreground="#FF64748B" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ServerUrlTextBox" Grid.Column="0" Height="36" IsReadOnly="True" FontSize="13" FontWeight="SemiBold" Foreground="#FF0F172A" Background="#FFF8FAFC" BorderBrush="#FFCBD5E1" BorderThickness="1" VerticalContentAlignment="Center" Padding="10,0" />
                            <Button x:Name="CopyUrlButton" Grid.Column="1" Content="Copy URL" Height="36" Padding="14,0" Margin="8,0,0,0" Background="#FF1E293B" BorderBrush="#FF334155" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="12" Click="CopyUrlButton_Click" Cursor="Hand" />
                            <Button x:Name="OpenBrowserButton" Grid.Column="2" Content="Open in Browser" Height="36" Padding="14,0" Margin="8,0,0,0" Background="#FF4F46E5" BorderBrush="#FF4338CA" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="12" Click="OpenBrowserButton_Click" Cursor="Hand" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Note -->
                <Border Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Incoming buzzes are queued with millisecond timestamps and appear directly on the Quizmaster desk." FontSize="11" Foreground="#FF475569" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#FFF1F5F9" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <TextBlock x:Name="DialogStatusText" Text="Ready for contestant buzzes." FontSize="11" Foreground="#FF64748B" VerticalAlignment="Center" />
                <Button Content="Done / Keep Running" Height="32" Padding="18,0" HorizontalAlignment="Right" Background="#FF0F172A" BorderBrush="#FF1E293B" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="12" Click="CloseButton_Click" Cursor="Hand" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
